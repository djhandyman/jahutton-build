---
import '@fontsource-variable/fraunces';
import '@fontsource-variable/inter';
import '../styles/global.css';
import Banner from '../components/Banner.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import FeedbackWidget from '../components/FeedbackWidget.astro';
import { site } from '../data/site.js';

const {
  title = `${site.name} — Builder`,
  // Description is the post-pivot positioning (docs-refresh), NOT main's older
  // "builds software, systems, teams…" line — that predates the audience-named rewrite.
  description = 'Jonathan A. Hutton designs, builds, and ships — software, strategy, and structure for solo operators, small businesses, and nonprofits.',
  // OG/Twitter card props come from the launch-polish branch (PR #2).
  ogImage = '/og-default.png',
  ogImageAlt = 'Jonathan A. Hutton — I design, build, and ship.',
  // Article metadata, for /notes/<slug> (2026-08-03). The defaults preserve every other
  // page's output byte-for-byte: og:type stays "website", and the two article:* tags
  // don't render at all unless a date is passed.
  ogType = 'website',
  publishedTime = null,
  modifiedTime = null,
  // Bare mode: head, styles and fonts as normal, but none of the furniture (2026-08-06, for
  // /welcome/). It exists for a page that renders OUTSIDE the guarded site, where every piece
  // of furniture points somewhere the visitor can't go — the nav links are login walls, the
  // footer repeats them, and FeedbackWidget POSTs to /api/feedback, which Access blocks.
  // Default false, so every other page's output is byte-identical.
  bare = false,
  // Emits <meta name="robots" content="noindex">. For a page that is temporary rather than
  // secret — /welcome/ is a coming-soon splash with a deletion date, and a thin page like that
  // is exactly what lingers in results next to the real home page after launch. Pairs with the
  // sitemap exclusion in astro.config.mjs; neither works alone.
  noindex = false,
} = Astro.props;

const canonical = new URL(Astro.url.pathname, Astro.site).href;
const ogImageUrl = new URL(ogImage, Astro.site).href;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex" />}
    <link rel="canonical" href={canonical} />

    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon-32.png" type="image/png" sizes="32x32" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta name="theme-color" content="#b55627" />

    {/* Feed autodiscovery. Site-wide because BaseLayout has no head slot, and a reader
        should be able to find the feed from any page rather than only from /notes. */}
    <link
      rel="alternate"
      type="application/rss+xml"
      title="Notes — Jonathan A. Hutton"
      href="/rss.xml"
    />

    <meta property="og:type" content={ogType} />
    {publishedTime && <meta property="article:published_time" content={publishedTime} />}
    {modifiedTime && <meta property="article:modified_time" content={modifiedTime} />}
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={ogImageAlt} />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />
    <meta name="twitter:image:alt" content={ogImageAlt} />
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    {!bare && <Banner />}
    {!bare && <Header />}
    <main id="main">
      <slot />
    </main>
    {!bare && <Footer />}
    {!bare && <FeedbackWidget />}
  </body>
</html>
