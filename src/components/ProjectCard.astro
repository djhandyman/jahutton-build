---
const { title, category, role, blurb, href, status } = Astro.props;
---
<article class="card">
  <p class="card__category">{category}</p>
  <h2 class="card__title">
    {href ? <a href={href} rel="noopener">{title}</a> : title}
    {status && <span class="card__status">{status}</span>}
  </h2>
  {role && <p class="card__role">{role}</p>}
  <p class="card__blurb">{blurb}</p>
</article>

<style>
  .card {
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius);
    padding: var(--space-6);
    height: 100%;
    transition: transform 0.15s ease, box-shadow 0.15s ease, border-color 0.15s ease;
  }
  /* Only cards that link anywhere get the interactive lift. */
  .card:has(.card__title a):hover {
    transform: translateY(-2px);
    box-shadow: var(--shadow);
    border-color: var(--color-accent);
  }
  .card__category {
    text-transform: uppercase;
    letter-spacing: 0.06em;
    font-size: var(--text-sm);
    color: var(--color-text-muted);
    margin-bottom: var(--space-2);
  }
  .card__title { font-size: var(--text-xl); line-height: 1.2; margin-bottom: var(--space-2); }
  .card__title a { text-decoration: none; color: inherit; }
  .card__title a:hover { color: var(--color-accent); }
  .card__status {
    margin-left: var(--space-2);
    font-family: var(--font-body);
    font-size: var(--text-sm);
    color: var(--color-text-muted);
    font-weight: 400;
  }
  .card__role { color: var(--color-text-muted); margin-bottom: var(--space-3); font-weight: 600; }
  .card__blurb { margin: 0; max-width: none; }
</style>
