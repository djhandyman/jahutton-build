---
import { site, nav } from '../data/site.js';
const path = Astro.url.pathname;

// Prefix match, not equality. Two reasons, and the first is a live bug fix:
//   · Astro's default build.format is "directory", so every page renders with
//     Astro.url.pathname === "/work/", while the nav hrefs in site.js are written
//     "/work". `path === item.href` was therefore FALSE ON EVERY PAGE — verified
//     2026-08-03, `grep -o 'aria-current' -r dist --include=*.html` returned nothing.
//     The rust underline below had never rendered on the live site.
//   · A section should stay lit on its detail pages: /work/<slug>, /notes/<slug>.
const isActive = (href) => {
  const base = href.replace(/\/+$/, '');
  if (base === '') return path === '/'; // guard, in case "/" ever joins the nav
  return path === base || path.startsWith(`${base}/`);
};
---
<header class="site-header">
  <div class="container site-header__inner">
    <a class="site-header__brand" href="/">{site.domain}</a>
    <nav aria-label="Primary">
      <ul class="site-header__nav">
        {nav.map((item) => (
          <li>
            <a href={item.href} aria-current={isActive(item.href) ? 'page' : undefined}>
              {item.label}
            </a>
          </li>
        ))}
      </ul>
    </nav>
  </div>
</header>

<style>
  .site-header {
    border-bottom: 1px solid var(--color-border);
    background: var(--color-bg);
  }
  .site-header__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-4);
    padding-block: var(--space-4);
  }
  .site-header__brand {
    font-family: var(--font-heading);
    font-weight: 700;
    font-size: var(--text-lg);
    text-decoration: none;
    color: var(--color-text);
  }
  .site-header__nav {
    display: flex;
    /* Four items fit a 320px row; a fifth (Notes, when it's unhidden) does not.
       Wrapping is cheaper than a mobile menu and needs no JS. */
    flex-wrap: wrap;
    gap: var(--space-3) var(--space-6);
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .site-header__nav a {
    text-decoration: none;
    color: var(--color-text);
    padding-block: var(--space-1);
    border-bottom: 2px solid transparent;
    transition: color 0.15s ease, border-color 0.15s ease;
  }
  .site-header__nav a:hover { color: var(--color-accent); }
  .site-header__nav a[aria-current='page'] {
    color: var(--color-accent);
    border-bottom-color: var(--color-accent);
  }
  .site-header__brand:hover { color: var(--color-accent); }
</style>
