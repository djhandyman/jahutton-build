---
// Contact form → posts to the /api/contact Cloudflare Pages Function, which emails via Resend.
// Progressive enhancement: JS submits inline via fetch and shows a status message; with JS off,
// the native POST still works and the function redirects to /thanks/.
import NextStepCard from './NextStepCard.astro';
import { site, contact } from '../data/site.js';
---
<form class="contact-form" action={site.contactEndpoint} method="POST">
  <div class="contact-form__field">
    <label for="name">Name</label>
    <input id="name" name="name" type="text" autocomplete="name" required />
  </div>
  <div class="contact-form__field">
    <label for="email">Email</label>
    <input id="email" name="email" type="email" autocomplete="email" required />
  </div>
  <div class="contact-form__field">
    <label for="message">Message</label>
    <textarea id="message" name="message" rows="6" required></textarea>
  </div>
  <div class="contact-form__field">
    <label for="timeline">{contact.timelineLabel}</label>
    <select id="timeline" name="timeline">
      <option value="">—</option>
      {/* value is `key|label` — the key is what the Function tests to decide whether to
          offer the Build Assessment, the label is what prints in Jon's email. See the
          note on timelineOptions in src/data/site.js. */}
      {contact.timelineOptions.map((o) => (
        <option value={`${o.value}|${o.label}`}>{o.label}</option>
      ))}
    </select>
    <p class="contact-form__hint">{contact.timelineHint}</p>
  </div>
  <!-- Honeypot for spam (a bot that fills this hidden field is silently dropped) -->
  <input type="text" name="website" tabindex="-1" autocomplete="off" class="visually-hidden" aria-hidden="true" />
  <!-- Cloudflare Turnstile: renders only with JS. The Function verifies the token when present,
       and falls back to the honeypot for no-JS submits (contact form is near-zero cost per send).
       appearance="interaction-only" keeps the widget out of sight for ordinary visitors — it
       appears ONLY if Cloudflare decides this visitor has to solve something. Do not swap this
       for `display: none`: a Managed widget that needs interaction would render where nobody can
       reach it, no token would be issued, and the submit would fail with nothing the visitor
       could do about it. -->
  <div
    class="cf-turnstile contact-form__turnstile"
    data-sitekey={site.turnstileSiteKey}
    data-appearance="interaction-only"
  ></div>
  <button class="btn" type="submit">Send</button>
  <p class="contact-form__status" role="status" aria-live="polite"></p>
</form>

<!-- The JS path never navigates, so the Build Assessment offer that a no-JS submitter would
     meet on /thanks/build-assessment/ appears here instead — revealed only when the Function
     answers `next: "assessment"`. Outside the <form> so form.reset() can't touch it. -->
<NextStepCard hidden id="contact-next-step" />

<!-- Turnstile loader — is:inline so Astro ships it verbatim, async so it never blocks the form. -->
<script is:inline async defer src="https://challenges.cloudflare.com/turnstile/v0/api.js"></script>

<script>
  const form = document.querySelector('.contact-form');
  if (form) {
    const status = form.querySelector('.contact-form__status');
    const button = form.querySelector('button[type="submit"]');
    const nextStep = document.getElementById('contact-next-step');
    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      status.textContent = '';
      status.classList.remove('is-error', 'is-ok');
      const label = button.textContent;
      button.disabled = true;
      button.textContent = 'Sending…';
      try {
        const fd = new FormData(form);
        const res = await fetch(form.action, {
          method: 'POST',
          headers: { 'content-type': 'application/json', accept: 'application/json' },
          body: JSON.stringify({
            name: fd.get('name'),
            email: fd.get('email'),
            message: fd.get('message'),
            timeline: fd.get('timeline'),
            website: fd.get('website'),
            turnstile: fd.get('cf-turnstile-response'),
          }),
        });
        const data = await res.json().catch(() => ({}));
        if (res.ok && data.ok) {
          form.reset();
          status.textContent = 'Thanks — your message is on its way. I’ll get back to you.';
          status.classList.add('is-ok');
          // The Function decides who sees this, not the browser — the same timeline rule that
          // picks the redirect target for a no-JS submit. Reveal only, never re-hide: a second
          // send that doesn't qualify shouldn't yank away something already on screen.
          if (data.next === 'assessment' && nextStep) nextStep.hidden = false;
        } else {
          status.textContent = data.error || 'Something went wrong. Please try again in a moment.';
          status.classList.add('is-error');
        }
      } catch {
        status.textContent = 'Couldn’t send just now. Please try again, or reach me on LinkedIn.';
        status.classList.add('is-error');
      } finally {
        button.disabled = false;
        button.textContent = label;
      }
    });
  }
</script>

<style>
  .contact-form { max-width: var(--measure); }
  .contact-form__field { margin-bottom: var(--space-4); }
  .contact-form__field label {
    display: block;
    font-weight: 600;
    margin-bottom: var(--space-2);
  }
  .contact-form input,
  .contact-form textarea,
  .contact-form select {
    width: 100%;
    padding: var(--space-3);
    font: inherit;
    color: inherit;
    background: var(--color-bg);
    border: 1px solid var(--color-border);
    border-radius: var(--radius);
  }
  .contact-form textarea { resize: vertical; }
  /* No margin on the Turnstile container itself. With appearance="interaction-only" it is a
     zero-height box on almost every visit, and a margin there would leave a permanent phantom
     gap above the button. Spacing lives on the button instead, so an invisible widget costs
     nothing. On the rare visit where a challenge does render, it sits a little tight against
     the field above — the right trade for a gap nobody sees the rest of the time. */
  .contact-form__turnstile + .btn { margin-top: var(--space-4); }
  .contact-form__hint {
    margin: var(--space-2) 0 0;
    font-size: var(--text-sm);
    color: var(--color-text-muted);
  }
  .contact-form__status { margin: var(--space-4) 0 0; font-size: var(--text-base); }
  .contact-form__status.is-ok { color: var(--color-accent); }
  .contact-form__status.is-error { color: var(--rust, #b3402a); }
  .contact-form__status:empty { margin: 0; }
</style>
