---
// The testimonial block on a project detail page. Data shape lives in src/data/projects.js →
// `testimonial` ({ quote, name, role, org, photo, placeholder, placement }).
//
// Lifted out of work/[slug].astro on 2026-08-04, when a SECOND position appeared: Ascension
// puts the CTA above the quote (`placement: 'after-cta'`) while every other page keeps
// quote-then-CTA. Two positions meant either duplicating thirty lines of markup or moving them
// here, and duplicated markup is the version that drifts. Exactly the reasoning that lifted
// ProjectParts, and the README's component count moved with it — thirteen to fourteen.
//
// The styles came along rather than staying behind in [slug].astro: Astro scopes CSS per
// component, so a `.quote` rule left in the page would no longer reach this markup.
const { quote } = Astro.props;

// `quote.quote` is a string OR an array of paragraphs — same normalize-to-array move `blurb`
// makes in [slug].astro, and for the same reason: one shape at the top, one loop below.
//
// The array form exists for a quote too long to sit in full above the CTA (Austin's, 2026-08-06).
// Cutting it would be the easy fix and the wrong one — the concrete before/after is what earns
// the block, so the whole thing ships and the page folds the tail away instead. The first
// paragraph (or `expandAfter` of them) stays open; the rest go inside a <details>.
//
// <details>/<summary>, NOT a JS toggle: this is a static build and progressive enhancement is
// real here (see the Functions' dual-mode rule). Native disclosure gets the expanded/collapsed
// semantics, keyboard handling and in-page find for free, works with JS off, and adds no bytes.
const paragraphs = (Array.isArray(quote.quote) ? quote.quote : [quote.quote]).filter(Boolean);
const openCount = Math.max(1, quote.expandAfter ?? 1);
const lead = paragraphs.slice(0, openCount);
const rest = paragraphs.slice(openCount);

// Marks on the OUTSIDE of the whole quote only — one opening, one closing. The print convention
// (an opening mark on every paragraph) was tried first and Jon rejected it 2026-08-06: on screen
// a stray “ at the top of paragraphs two, three and four reads as a typo, not as continuation.
// The collapsed state therefore ends unclosed, which is what the ellipsis is for.
const openMark = '“';
const closeMark = '”';

// Monogram stand-in while there's no headshot. Two initials max, so "Austin" gives A and a
// full name would give two — placeholders currently carry first names only (see CLAUDE.md).
const initials = quote.name
  .split(/\s+/)
  .map((w) => w.replace(/[^a-zA-Z]/g, '').charAt(0))
  .filter(Boolean)
  .slice(0, 2)
  .join('')
  .toUpperCase();
---

<figure class="quote">
  <blockquote class="quote__text">
    {lead.map((p, i) => (
      <p>{i === 0 ? openMark : ''}{p}{rest.length === 0 && i === lead.length - 1 ? closeMark : ''}</p>
    ))}
    {rest.length > 0 && (
      <details class="quote__more">
        <summary class="quote__more-toggle">
          <span class="quote__more-label quote__more-label--more">Continue reading</span>
          <span class="quote__more-label quote__more-label--less">Show less</span>
        </summary>
        {rest.map((p, i) => (
          <p>{p}{i === rest.length - 1 ? closeMark : ''}</p>
        ))}
      </details>
    )}
  </blockquote>
  <figcaption class="quote__who">
    {quote.photo ? (
      <picture>
        <source srcset={`${quote.photo.src}.webp`} type="image/webp" />
        <img
          class="quote__avatar"
          src={`${quote.photo.src}.jpg`}
          width={quote.photo.width}
          height={quote.photo.height}
          alt={quote.photo.alt}
          loading="lazy"
          decoding="async"
        />
      </picture>
    ) : (
      <span class="quote__avatar quote__avatar--empty" aria-hidden="true">{initials}</span>
    )}
    <span class="quote__who-text">
      <span class="quote__name">{quote.name}</span>
      {(quote.role || quote.org) && (
        <span class="quote__role">{[quote.role, quote.org].filter(Boolean).join(', ')}</span>
      )}
    </span>
  </figcaption>
  {/* Renders only while `placeholder: true`. Deleting that one flag is what makes a
      testimonial live — nothing invented can reach the page looking real. */}
  {quote.placeholder && <p class="quote__flag">Placeholder — not a real quote</p>}
</figure>

<style>
  /* Same measure as the body so it reads as part of the column, with a rust edge and the
     surface tint to lift it off the page. */
  .quote {
    margin: var(--space-12) 0 0;
    max-width: var(--measure);
    padding: var(--space-6);
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-left: 3px solid var(--color-accent);
    border-radius: var(--radius);
  }
  .quote__text { margin: 0; }
  .quote__text p {
    margin: 0;
    font-family: var(--font-heading);
    font-size: var(--text-lg);
    line-height: 1.5;
  }
  .quote__text p + p,
  .quote__more p { margin-top: var(--space-4); }

  /* The disclosure. No marker — the label is the affordance, and a triangle next to a pull
     quote reads as file-tree furniture. Body font and small, so the toggle is plainly the
     page talking rather than part of what Austin said. */
  .quote__more { margin-top: var(--space-4); }
  .quote__more-toggle {
    display: inline-flex;
    gap: var(--space-2);
    cursor: pointer;
    font-family: var(--font-body);
    font-size: var(--text-sm);
    color: var(--color-accent);
    list-style: none; /* Firefox */
  }
  .quote__more-toggle::-webkit-details-marker { display: none; }
  .quote__more-toggle:hover .quote__more-label { text-decoration: underline; text-underline-offset: 3px; }
  .quote__more-toggle:focus-visible { outline: 2px solid var(--color-accent); outline-offset: 3px; }
  .quote__more:not([open]) .quote__more-label--less,
  .quote__more[open] .quote__more-label--more { display: none; }

  /* Ellipsis on the last OPEN paragraph while the rest is folded away, so the cut reads as a
     fold and not as a quote that stops mid-thought. The revealed paragraphs live inside
     <details>, so `> p:last-of-type` can only ever be the last visible one. :has() carries it;
     where that's missing the quote simply ends without the ellipsis. */
  .quote__text:has(> .quote__more:not([open])) > p:last-of-type::after { content: '…'; }
  .quote__who {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    margin-top: var(--space-6);
  }
  .quote__avatar {
    width: 56px;
    height: 56px;
    flex: none;
    border-radius: 50%;
    object-fit: cover; /* a non-square headshot crops to the circle instead of squashing */
    background: var(--color-bg);
  }
  /* Stand-in until a real headshot lands — dashed, so it reads as "photo pending". */
  .quote__avatar--empty {
    display: grid;
    place-items: center;
    border: 1px dashed var(--color-border);
    color: var(--color-text-muted);
    font-family: var(--font-heading);
    font-size: var(--text-xl);
  }
  .quote__who-text { display: flex; flex-direction: column; }
  .quote__name { font-weight: 600; }
  .quote__role { font-size: var(--text-sm); color: var(--color-text-muted); }
  .quote__flag {
    margin: var(--space-4) 0 0;
    font-size: var(--text-sm);
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--color-text-muted);
  }
</style>
