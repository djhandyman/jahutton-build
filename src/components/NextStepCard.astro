---
// The post-contact Build Assessment offer. Rendered in two places, deliberately identical:
//   • ContactForm.astro — hidden, revealed in place after a qualifying JS submit
//   • src/pages/thanks/build-assessment.astro — the no-JS 303 target for the same case
// Copy lives in `assessment.nextStep` (src/data/site.js); this component is presentation-only.
//
// `hidden` renders it with the [hidden] attribute for the ContactForm case. Note that the
// markup ships either way — it is four lines of static HTML, and duplicating it as a JS
// template string would put the copy somewhere the data file doesn't reach.
import { assessment } from '../data/site.js';

const { hidden = false, id } = Astro.props;
const step = assessment.nextStep;
---
<aside class="next-step" id={id} hidden={hidden}>
  <h2 class="next-step__heading">{step.heading}</h2>
  <p class="next-step__body">{step.body}</p>
  <p class="next-step__cta">
    <a class="btn btn--ghost" href={step.href}>{step.ctaLabel}</a>
  </p>
</aside>

<style>
  .next-step {
    max-width: var(--measure);
    /* Was `--space-10` until 2026-08-02 — not a token on the scale (1/2/3/4/6/8/12/16/24), so
       the declaration was invalid at computed-value time and this card butted straight against
       whatever sat above it, on /contact and on both thanks pages. */
    margin-top: var(--space-12);
    padding: var(--space-6);
    background: var(--color-bg);
    border: 1px solid var(--color-border);
    border-left: 3px solid var(--color-accent);
    border-radius: var(--radius);
  }
  /* [hidden] needs the explicit rule: the element is display:block above, and a bare
     [hidden] attribute loses to any later display declaration in the cascade. */
  .next-step[hidden] { display: none; }
  .next-step__heading {
    font-family: var(--font-sans);
    font-size: var(--text-base);
    font-weight: 600;
    margin: 0 0 var(--space-3);
  }
  .next-step__body { margin-bottom: var(--space-4); }
  .next-step__cta { margin: 0; }
</style>
