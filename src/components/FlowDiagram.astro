---
// Request-flow diagram for the "how this site is built" case study.
// Presentation only — every label comes from src/data/colophon.js → `flow`.
//
// Deliberately hand-built from HTML + CSS on the existing design tokens. No SVG, no diagram
// library: this thing illustrates an argument about not over-building, so adding a dependency
// to draw it would be a bad joke. The practical payoff is that the text is real text — it
// reflows, it scales with the reader's font size, and it's selectable and searchable.
//
// Responsive strategy: each lane is a grid that runs left→right on wide screens and stacks
// top→bottom below 52rem. The connector arrows are CSS `content`, so they turn from → into ↓
// at the same breakpoint. Nothing scrolls sideways.
import { flow } from '../data/colophon.js';
---
<figure class="flow">
  <figcaption class="flow__head">
    <h3 class="flow__title">{flow.heading}</h3>
    <p class="flow__lead">{flow.lead}</p>
  </figcaption>

  {/* The shared gate — everything below passes through this first. */}
  <div class="flow__gate">
    <p class="flow__gate-label">{flow.gate.label}</p>
    <ul class="flow__gate-items">
      {flow.gate.items.map((item) => <li>{item}</li>)}
    </ul>
    <p class="flow__gate-note">{flow.gate.note}</p>
  </div>

  <p class="flow__down" aria-hidden="true"></p>

  <div class="flow__lanes">
    {flow.lanes.map((lane) => (
      <div class="flow__lane">
        <div class="flow__node flow__node--form">
          <p class="flow__node-label">In the browser</p>
          <p class="flow__node-name">{lane.form}</p>
        </div>

        <p class="flow__arrow" aria-hidden="true"></p>

        <div class="flow__node flow__node--fn">
          <p class="flow__node-label">Function</p>
          <p class="flow__node-name"><code>{lane.endpoint}</code></p>
          <p class="flow__node-note">{lane.gateNote}</p>
        </div>

        <p class="flow__arrow" aria-hidden="true"></p>

        <ul class="flow__services">
          {lane.services.map((svc) => (
            <li class={`flow__svc flow__svc--${svc.policy === 'required' ? 'req' : 'best'}`}>
              <span class="flow__svc-name">{svc.name}</span>
              <span class="flow__svc-detail">{svc.detail}</span>
              <span class="flow__svc-policy">{svc.policy}</span>
            </li>
          ))}
          {lane.returns && <li class="flow__returns">↩ {lane.returns}</li>}
        </ul>
      </div>
    ))}
  </div>

  <ul class="flow__legend">
    {flow.legend.map((item) => (
      <li class={`flow__legend-item flow__legend-item--${item.policy === 'required' ? 'req' : 'best'}`}>
        <span class="flow__legend-key">{item.policy}</span>
        {item.text}
      </li>
    ))}
  </ul>

  <p class="flow__note">{flow.note}</p>
</figure>

<style>
  /* Wider than --measure (body text) but inside the container — an inset exhibit,
     matching the .ba before/after gallery on the same template. */
  .flow {
    margin: var(--space-12) 0 0;
    max-width: 56rem;
  }

  .flow__head { margin-bottom: var(--space-8); }
  .flow__title {
    font-family: var(--font-heading);
    font-size: var(--text-xl);
    line-height: var(--leading-heading);
    margin: 0 0 var(--space-2);
  }
  .flow__lead {
    margin: 0;
    color: var(--color-text-muted);
    max-width: var(--measure);
  }

  /* --- The shared gate --- */
  .flow__gate {
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    /* Teal at low opacity — the secondary accent, kept quiet so it reads as a band
       rather than competing with the rust used for the required paths below. */
    background: rgba(47, 93, 99, 0.07);
    padding: var(--space-4) var(--space-6);
    text-align: center;
  }
  .flow__gate-label {
    margin: 0 0 var(--space-2);
    font-size: var(--text-sm);
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--color-secondary);
    font-weight: 600;
  }
  .flow__gate-items {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: var(--space-2) var(--space-3);
    list-style: none;
    margin: 0;
    padding: 0;
    font-family: var(--font-heading);
    font-size: var(--text-lg);
  }
  /* Interpuncts between the gate items, drawn rather than typed so the list stays a list. */
  .flow__gate-items li + li::before {
    content: '·';
    margin-right: var(--space-3);
    color: var(--color-border);
  }
  .flow__gate-note {
    margin: var(--space-3) 0 0;
    font-size: var(--text-sm);
    color: var(--color-text-muted);
    max-width: none;
  }

  /* max-width:none is load-bearing on every centered <p> here — global.css caps p at
     --measure (38rem), which inside this 56rem figure would centre the text within a
     38rem block and leave the arrow visibly off to the left. */
  .flow__down {
    margin: var(--space-3) 0;
    max-width: none;
    text-align: center;
    color: var(--color-border);
    font-size: var(--text-xl);
    line-height: 1;
  }
  .flow__down::before { content: '↓'; }

  /* --- Lanes --- */
  .flow__lanes {
    display: grid;
    gap: var(--space-4);
  }
  .flow__lane {
    display: grid;
    gap: var(--space-3);
    align-items: center;
    padding: var(--space-4);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    background: var(--color-bg);
  }

  .flow__node { min-width: 0; }
  .flow__node-label {
    margin: 0 0 var(--space-1);
    max-width: none;
    font-size: var(--text-sm);
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--color-text-muted);
  }
  .flow__node-name {
    margin: 0;
    font-family: var(--font-heading);
    font-size: var(--text-lg);
    line-height: 1.25;
    max-width: none;
  }
  .flow__node-name code {
    font-family: ui-monospace, SFMono-Regular, Menlo, Consolas, monospace;
    font-size: 0.85em;
    word-break: break-all;
  }
  .flow__node-note {
    margin: var(--space-2) 0 0;
    font-size: var(--text-sm);
    color: var(--color-text-muted);
    max-width: none;
  }

  .flow__arrow {
    margin: 0;
    max-width: none;
    text-align: center;
    color: var(--color-border);
    font-size: var(--text-xl);
    line-height: 1;
  }
  .flow__arrow::before { content: '↓'; }

  /* --- Services --- */
  .flow__services {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: var(--space-2);
    min-width: 0;
  }
  .flow__svc {
    display: grid;
    grid-template-columns: 1fr auto;
    gap: 0 var(--space-3);
    align-items: baseline;
    padding: var(--space-2) var(--space-3);
    border-radius: var(--radius);
    background: var(--color-surface);
    /* The policy is carried by the left edge: solid rust = required, dashed grey =
       allowed to fail. Colour is never the only cue — the word is printed too. */
    border-left: 3px solid var(--color-border);
  }
  .flow__svc--req { border-left-style: solid; border-left-color: var(--color-accent); }
  .flow__svc--best { border-left-style: dashed; border-left-color: var(--color-text-muted); }

  .flow__svc-name { font-weight: 600; }
  .flow__svc-detail {
    grid-column: 1;
    font-size: var(--text-sm);
    color: var(--color-text-muted);
  }
  .flow__svc-policy {
    grid-row: 1 / span 2;
    grid-column: 2;
    align-self: center;
    font-size: var(--text-sm);
    text-transform: uppercase;
    letter-spacing: 0.06em;
    white-space: nowrap;
  }
  .flow__svc--req .flow__svc-policy { color: var(--color-accent); font-weight: 600; }
  .flow__svc--best .flow__svc-policy { color: var(--color-text-muted); }

  .flow__returns {
    padding: var(--space-2) var(--space-3);
    font-size: var(--text-sm);
    color: var(--color-secondary);
    font-style: italic;
  }

  /* --- Legend + note --- */
  .flow__legend {
    list-style: none;
    margin: var(--space-6) 0 0;
    padding: 0;
    display: grid;
    gap: var(--space-2);
    font-size: var(--text-sm);
    color: var(--color-text-muted);
  }
  .flow__legend-item { padding-left: var(--space-4); border-left: 3px solid var(--color-border); }
  .flow__legend-item--req { border-left-style: solid; border-left-color: var(--color-accent); }
  .flow__legend-item--best { border-left-style: dashed; border-left-color: var(--color-text-muted); }
  .flow__legend-key {
    text-transform: uppercase;
    letter-spacing: 0.06em;
    font-weight: 600;
    margin-right: var(--space-2);
    color: var(--color-text);
  }

  .flow__note {
    margin: var(--space-6) 0 0;
    padding-top: var(--space-6);
    border-top: 1px solid var(--color-border);
    max-width: var(--measure);
  }

  /* --- Wide: lanes run left → right --- */
  @media (min-width: 52rem) {
    .flow__lane {
      grid-template-columns: 1fr auto 1.1fr auto 1.4fr;
      gap: var(--space-4);
      padding: var(--space-6);
    }
    .flow__arrow::before { content: '→'; }
    .flow__legend { grid-template-columns: 1fr 1fr; gap: var(--space-4); }
  }
</style>
