---
// /kitchen — the kitchen remodel, stage by stage. Added 2026-11-12.
// All words are in src/data/kitchen.js; all photo titles/captions/dims are generated into
// src/data/kitchen-photos.js by scripts/kitchen-images.mjs. This file only lays them out.
//
// No new components, deliberately: the README claims fourteen and four dependencies, both
// checkable against this public repo. Everything repeated here is a loop over data on one page,
// which is the same call [slug].astro makes for .hero/.mark/.path ("markup, not logic").
import BaseLayout from '../layouts/BaseLayout.astro';
import {
  page, hero, stages, revealTile, beforeAfter, showcase, durat, sawbox, steel, claude, closing,
} from '../data/kitchen.js';
import { photos, exhibits, heroImage, heroPhoneImage, showcaseImages, detailImages, afterImages } from '../data/kitchen-photos.js';

// ── image helpers ── (shape: see the header of kitchen-photos.js)
const srcset = (img) => img.widths.map((w) => `${img.src}-${w}.webp ${w}w`).join(', ');
const largest = (img) => `${img.src}-${img.widths.at(-1)}.webp`;
// Alt text = title + caption (Jon's spec). The caption is also visible under the photo, so a
// screen reader hears it twice in the gallery; the alone-in-the-viewer case is why it's worth it.
// A photo that carries its own `alt` (the finished-kitchen detail shots — Jon's descriptions) uses it.
const altOf = (p) => p.alt ?? `${p.title}: ${p.caption}`;

// Grid photo widths, matched to the .photos grid below: 2-up on a phone, 3-up from 48rem,
// 4-up from 64rem, capped by the 70rem container.
const GRID_SIZES = '(min-width: 70rem) 16rem, (min-width: 64rem) 23vw, (min-width: 48rem) 30vw, 46vw';

// Per stage: every photo, inline, in story order (ids sort chronologically, extras included —
// see kitchen.js → extraPhotos). Until 2026-11-13 the print set led and the rest sat behind a
// "More photos" fold; Jon asked for more photos on the page and not to hew to the printed ones,
// so the fold went. The glance thumbnail is still the first print-set photo where there is one,
// because those were picked to stand for their stage.
const byStage = stages.map((s) => {
  const mine = photos.filter((p) => p.stage === s.id);
  const thumb = mine.filter((p) => p.print !== null).sort((a, b) => a.print - b.print)[0] ?? mine[0];
  return { ...s, facts: s.facts.filter((f) => !f.hold), photos: mine, thumb };
});

// Before/after pairs. `before` is a gallery photo id; the script refuses a held or missing one.
const BA_SIZES = '(min-width: 60rem) 56rem, 100vw';
const pairs = beforeAfter.pairs.map((pair) => ({
  ...pair,
  beforePhoto: photos.find((p) => p.id === pair.before),
  afterImg: afterImages[pair.id] ?? null,
}));

// The lighting card's photos: finished-kitchen images already generated for the hero and the
// showcase, cropped in by CSS. One that's missing drops out rather than breaking the build.
const steelPhotos = steel.photos
  .map((sp) => ({ ...sp, img: sp.image === 'heroPhone' ? heroPhoneImage : showcaseImages[sp.image] }))
  .filter((sp) => sp.img);

// Plain-string segment renderer for the few credit lines that carry a link — same shape as
// about.js, so nothing new to learn.
const isExternal = (href) => !href.startsWith('/');

// ── the cut plan, drawn to scale ──
// Built as an SVG string and injected with set:html, because it's drawn in four places' worth of
// geometry and a component would add to the README's count. Every string in it is our own data,
// escaped anyway.
const esc = (s) => String(s).replace(/[&<>"]/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' })[c]);
const cutSheetSvg = (sheet, n) => {
  const { w, h } = durat.cutPlan.sheet;
  const parts = sheet.pieces.map((p) => {
    const cx = p.x + p.w / 2;
    const cy = p.y + p.h / 2;
    const cls = p.spare ? 'cut__spare' : p.strip ? 'cut__strip' : 'cut__piece';
    // A narrow piece (the 14-7/8" spare) can't fit "14-7/8 × 31-1/2" on one line, so its size
    // wraps at the "×". ~1.15 user units per character at the 2.2px size.
    const [sw, sh] = p.size.split(' × ');
    const sizeText = p.size.length * 1.15 > p.w - 1
      ? `<text x="${cx}" y="${cy + 2.6}" class="cut__size">${esc(sw)} ×</text>` +
        `<text x="${cx}" y="${cy + 5}" class="cut__size">${esc(sh)}</text>`
      : `<text x="${cx}" y="${cy + 2.6}" class="cut__size">${esc(p.size)}</text>`;
    const text = p.strip
      ? `<text x="${cx}" y="${cy + 0.6}" class="cut__small">${esc(p.name)} · ${esc(p.size)}</text>`
      : `<text x="${cx}" y="${cy - 0.6}" class="cut__name">${esc(p.spare ? 'spare' : p.name)}</text>` + sizeText;
    return `<rect x="${p.x}" y="${p.y}" width="${p.w}" height="${p.h}" class="${cls}"/>${text}`;
  });
  const label = `Sheet ${n} of 3, ${durat.cutPlan.sheet.label} inches: ` +
    sheet.pieces.map((p) => `${p.name}, ${p.size}`).join('; ') + '.';
  return `<svg viewBox="-0.3 -0.3 ${w + 0.6} ${h + 0.6}" role="img" aria-label="${esc(label)}">` +
    `<rect x="0" y="0" width="${w}" height="${h}" class="cut__sheet"/>${parts.join('')}</svg>`;
};

const heroAlt = hero.alt;
const ogImage = '/images/kitchen/og.jpg';
---
<BaseLayout
  title={`${page.title} — Jonathan A. Hutton`}
  description={page.description}
  ogImage={ogImage}
  ogImageAlt={heroAlt}
>
  <div class="kitchen">
    <!-- ── Hero ─────────────────────────────────────────────────────────────── -->
    <header class="container k-hero">
      <p class="k-eyebrow">{page.eyebrow}</p>
      <h1>{page.title}</h1>
      {page.lead.map((p) => <p class="k-lead">{p}</p>)}
      {/* The one eager image on the page. Landscape from 40rem up, the portrait shot of the same
          view on a phone; width/height on each <source> keep the box right for whichever loads.
          Swap either in kitchen.js → hero, not here. */}
      <figure class="k-hero__fig" style={`--ar: ${heroImage.width / heroImage.height}`}>
        <picture>
          {heroPhoneImage && (
            <source
              media="(max-width: 39.99rem)"
              type="image/webp"
              srcset={srcset(heroPhoneImage)}
              sizes="100vw"
              width={heroPhoneImage.width}
              height={heroPhoneImage.height}
            />
          )}
          <source type="image/webp" srcset={srcset(heroImage)} sizes="(min-width: 60rem) 56rem, 100vw" />
          <img
            src={`${heroImage.src}.jpg`}
            width={heroImage.width}
            height={heroImage.height}
            alt={heroAlt}
            fetchpriority="high"
            decoding="async"
          />
        </picture>
        {hero.caption && <figcaption class="k-caption">{hero.caption}</figcaption>}
      </figure>
    </header>

    <!-- ── At a glance ──────────────────────────────────────────────────────── -->
    {/* Modelled on the printed Stages overview: eleven tiles in order, each a jump link, then the
        reveal. A <nav> because it IS the page's table of contents. */}
    <nav class="container k-glance" aria-labelledby="glance-h">
      <h2 id="glance-h">{page.glanceHeading}</h2>
      <ol class="glance">
        {byStage.map((s) => {
          const thumb = s.thumb;
          return (
            <li>
              <a class="glance__tile" href={`#stage-${s.id}`}>
                {thumb ? (
                  <img
                    class="glance__thumb"
                    src={`${thumb.img.src}-480.webp`}
                    width={thumb.img.width}
                    height={thumb.img.height}
                    alt=""
                    loading="lazy"
                    decoding="async"
                  />
                ) : (
                  <span class="glance__thumb glance__thumb--empty" aria-hidden="true" />
                )}
                <span class="glance__text">
                  <span class="glance__num" aria-hidden="true">{s.id}</span>
                  <span class="glance__title">{s.title}</span>
                  <span class="glance__line">{s.glance}</span>
                </span>
              </a>
            </li>
          );
        })}
        <li>
          <a class="glance__tile glance__tile--reveal" href="#reveal">
            <span class="glance__text">
              <span class="glance__title">{revealTile.title}</span>
              <span class="glance__line">{revealTile.text}</span>
            </span>
          </a>
        </li>
      </ol>
    </nav>

    <!-- ── The stages ───────────────────────────────────────────────────────── -->
    {byStage.map((s) => (
      <section class="container stage" id={`stage-${s.id}`} aria-labelledby={`stage-${s.id}-h`}>
        <div class="stage__head">
          <h2 id={`stage-${s.id}-h`} class="stage__title">
            <span class="stage__num"><span class="visually-hidden">Stage </span>{s.id}</span>
            <span>{s.title}</span>
          </h2>
          <p class="stage__when"><span class="stage__when-label">When</span> {s.when}</p>
        </div>
        <p class="stage__summary">{s.summary}</p>
        {s.facts.length > 0 && (
          <ul class="facts">
            {s.facts.map((f) => (
              <li><span class="facts__value">{f.value}</span> <span class="facts__label">{f.label}</span></li>
            ))}
          </ul>
        )}

        {s.photos.length > 0 && (
          <ul class="photos">
            {s.photos.map((p) => (
              <li>
                <figure class="photo">
                  <a class="photo__link" href={largest(p.img)} data-viewer data-title={p.title} data-caption={p.caption}>
                    <picture>
                      <source type="image/webp" srcset={srcset(p.img)} sizes={GRID_SIZES} />
                      <img
                        src={`${p.img.src}.jpg`}
                        width={p.img.width}
                        height={p.img.height}
                        alt={altOf(p)}
                        loading="lazy"
                        decoding="async"
                      />
                    </picture>
                  </a>
                  <figcaption><strong>{p.title}</strong> {p.caption}</figcaption>
                </figure>
              </li>
            ))}
          </ul>
        )}
      </section>
    ))}

    <!-- ── The reveal: showcase ─────────────────────────────────────────────── -->
    {/* The finished room. A slot with no source renders as a placeholder — see kitchen.js →
        showcase. Dashed and muted: the site's existing "pending" look. */}
    <section class="container reveal" id="reveal" aria-labelledby="reveal-h">
      <h2 id="reveal-h">{showcase.heading}</h2>
      {showcase.lead && <p class="k-lead">{showcase.lead}</p>}

      {/* Before and after. The two photos are stacked and a native range input wipes between
          them — keyboard, touch and screen readers for free. Without JS (no .ba--live) they sit
          side by side instead, since the slider can't move. A missing "after" is a placeholder
          panel in the same frame, so the pair already shows what it will do. */}
      <h3 class="ba-heading">{beforeAfter.heading}</h3>
      {beforeAfter.lead && <p>{beforeAfter.lead}</p>}
      <ul class="ba-list">
        {pairs.map((pair) => {
          const b = pair.beforePhoto;
          const a = pair.afterImg;
          return (
            <li>
              <figure class="ba" style={`--ar: ${b.img.width} / ${b.img.height}; --pos: 50%;`}>
                <div class="ba__frame">
                  <picture class="ba__before">
                    <source type="image/webp" srcset={srcset(b.img)} sizes={BA_SIZES} />
                    <img src={`${b.img.src}.jpg`} width={b.img.width} height={b.img.height} alt={`${beforeAfter.beforeLabel}: ${altOf(b)}`} loading="lazy" decoding="async" />
                  </picture>
                  <div class="ba__after">
                    {a ? (
                      <picture>
                        <source type="image/webp" srcset={srcset(a)} sizes={BA_SIZES} />
                        <img src={`${a.src}.jpg`} width={a.width} height={a.height} alt={`${beforeAfter.afterLabel}: ${pair.after.alt}`} loading="lazy" decoding="async" />
                      </picture>
                    ) : (
                      <div class="ba__slot">
                        <p class="slot__label">{beforeAfter.placeholderNote}</p>
                        <p class="slot__note">{pair.shotNote}</p>
                      </div>
                    )}
                  </div>
                  <span class="ba__tag ba__tag--before" aria-hidden="true">{beforeAfter.beforeLabel}</span>
                  <span class="ba__tag ba__tag--after" aria-hidden="true">{beforeAfter.afterLabel}</span>
                  <span class="ba__handle" aria-hidden="true"></span>
                  <input class="ba__range" type="range" min="0" max="100" value="50" hidden
                    aria-label={`${pair.label}: slide to compare before and after`} />
                </div>
                <figcaption>
                  <strong>{pair.label}</strong>
                  {beforeAfter.beforeLabel}: {b.title}. {b.caption}
                  {a && pair.after.caption && <> {beforeAfter.afterLabel}: {pair.after.caption}</>}
                </figcaption>
              </figure>
            </li>
          );
        })}
      </ul>

      <h3 class="ba-heading">{showcase.roomHeading}</h3>
      <ul class="showcase">
        {showcase.slots.map((slot) => {
          const img = showcaseImages[slot.id];
          return (
            <li class="showcase__item">
              {img ? (
                <figure class="photo">
                  <a class="photo__link" href={largest(img)} data-viewer data-title="" data-caption={slot.caption}>
                    <picture>
                      <source type="image/webp" srcset={srcset(img)} sizes="(min-width: 60rem) 18rem, (min-width: 48rem) 31vw, 46vw" />
                      <img src={`${img.src}.jpg`} width={img.width} height={img.height} alt={slot.alt} loading="lazy" decoding="async" />
                    </picture>
                  </a>
                  {slot.caption && <figcaption>{slot.caption}</figcaption>}
                </figure>
              ) : (
                <div class="slot">
                  <p class="slot__label">{slot.label}</p>
                  <p class="slot__note">{showcase.placeholderNote}</p>
                </div>
              )}
            </li>
          );
        })}
      </ul>
    </section>

    <!-- ── Materials and makers ─────────────────────────────────────────────── -->
    <section class="container makers" aria-labelledby="makers-h">
      <h2 id="makers-h">Materials and makers</h2>

      <article class="maker" aria-labelledby="durat-h">
        <p class="k-eyebrow">{durat.eyebrow}</p>
        <h3 id="durat-h" class="maker__title">{durat.title}</h3>
        <p class="k-lead">{durat.lead}</p>
        <ul class="stats">
          {durat.stats.map((s) => (
            <li><span class="stats__value">{s.value}</span> <span class="stats__label">{s.label}</span></li>
          ))}
        </ul>
        <p class="source"><a href={durat.claimsSource.href} rel="noopener">{durat.claimsSource.text}</a></p>
        {detailImages.durat && (
          <figure class="photo maker__photo">
            <a class="photo__link" href={largest(detailImages.durat)} data-viewer data-title="" data-caption="">
              <picture>
                <source type="image/webp" srcset={srcset(detailImages.durat)} sizes="(min-width: 40rem) 28rem, 92vw" />
                <img src={`${detailImages.durat.src}.jpg`} width={detailImages.durat.width} height={detailImages.durat.height} alt={durat.photo.alt} loading="lazy" decoding="async" />
              </picture>
            </a>
          </figure>
        )}

        <h4 class="maker__sub">{durat.stepsHeading}</h4>
        <ol class="steps">
          {durat.steps.map((st) => (
            <li><strong>{st.title}</strong> {st.text}</li>
          ))}
        </ol>

        <h4 class="maker__sub">{durat.cutPlan.heading}</h4>
        <figure class="cut">
          {durat.cutPlan.sheets.map((sh, i) => (
            <div class="cut__sheetwrap" set:html={cutSheetSvg(sh, i + 1)} />
          ))}
          <figcaption class="k-caption">{durat.cutPlan.caption}</figcaption>
        </figure>

        <p class="callout"><strong>{durat.callout.strong}</strong> {durat.callout.text}</p>
        <p class="credits">
          {durat.credits.map((line) => (
            <span>
              {line.map((seg) =>
                typeof seg === 'string' ? seg : (
                  <a href={seg.href} rel={isExternal(seg.href) ? 'noopener' : undefined}>{seg.text}</a>
                )
              )}
            </span>
          ))}
        </p>
      </article>

      <article class="maker" aria-labelledby="sawbox-h">
        <p class="k-eyebrow">{sawbox.eyebrow}</p>
        <h3 id="sawbox-h" class="maker__title"><a href={sawbox.href} rel="noopener">{sawbox.name}</a></h3>
        <p class="k-lead">{sawbox.headline}</p>
        <div class="maker__cols">
          <div>
            <h4 class="maker__sub">{sawbox.stepsHeading}</h4>
            <ol class="steps steps--one">
              {sawbox.steps.map((st) => (
                <li><strong>{st.title}</strong> {st.text}</li>
              ))}
            </ol>
            <p class="source"><a href={sawbox.stepsSource.href} rel="noopener">{sawbox.stepsSource.text}</a></p>
          </div>
          <div>
            <h4 class="maker__sub">{sawbox.specsHeading}</h4>
            <dl class="specs">
              {sawbox.specs.map(([k, v]) => (
                <div><dt>{k}</dt><dd>{v}</dd></div>
              ))}
            </dl>
          </div>
        </div>
        <p class="credits"><span><a href={sawbox.href} rel="noopener">sawbox.com</a></span><span>{sawbox.footer}</span></p>
      </article>

      <article class="maker" aria-labelledby="steel-h">
        <p class="k-eyebrow">{steel.eyebrow}</p>
        <h3 id="steel-h" class="maker__title"><a href={steel.href} rel="noopener">{steel.name}</a></h3>
        <p class="k-lead">{steel.lead}</p>
        <ul class="stats">
          {steel.stats.map((s) => (
            <li><span class="stats__value">{s.value}</span> <span class="stats__label">{s.label}</span></li>
          ))}
        </ul>
        <p class="source"><a href={steel.claimsSource.href} rel="noopener">{steel.claimsSource.text}</a></p>
        <h4 class="maker__sub">{steel.specsHeading}</h4>
        <dl class="specs">
          {steel.specs.map(([k, v]) => (
            <div><dt>{k}</dt><dd>{v}</dd></div>
          ))}
        </dl>
        {steelPhotos.length > 0 && (
          <ul class="lights">
            {steelPhotos.map(({ img, focus, caption }) => (
              <li>
                <figure class="photo">
                  <a class="photo__link" href={largest(img)} data-viewer data-title="" data-caption={caption}>
                    <picture>
                      <source type="image/webp" srcset={srcset(img)} sizes="(min-width: 60rem) 26rem, (min-width: 40rem) 46vw, 92vw" />
                      <img
                        src={`${img.src}.jpg`}
                        width={img.width}
                        height={img.height}
                        alt={caption}
                        style={`object-position: ${focus}`}
                        loading="lazy"
                        decoding="async"
                      />
                    </picture>
                  </a>
                  <figcaption>{caption}</figcaption>
                </figure>
              </li>
            ))}
          </ul>
        )}
        <p class="credits"><span><a href={steel.href} rel="noopener">steellightingco.com</a></span><span>{steel.footer}</span></p>
      </article>
    </section>

    <!-- ── Built with Claude ────────────────────────────────────────────────── -->
    <section class="container claude" aria-labelledby="claude-h">
      <p class="k-eyebrow">{claude.eyebrow}</p>
      <h2 id="claude-h">{claude.title}</h2>
      <p class="k-lead">{claude.lead}</p>
      <ul class="claude__stats">
        {claude.stats.map(([v, l]) => <li><strong>{v}</strong> {l}</li>)}
      </ul>
      <ol class="roles">
        {claude.roles.map((r, i) => (
          <li class="role">
            <h3 class="role__title"><span class="role__num" aria-hidden="true">{i + 1}</span> {r.title}</h3>
            <p class="role__text">{r.text}</p>
            {r.exhibit && !r.exhibit.hold && (
              <div class="role__exhibit">
                {r.exhibit.kind === 'circuits' && (
                  <table class="circuits">
                    <thead><tr><th scope="col">Circuit</th><th scope="col">Breaker</th><th scope="col">Wire</th></tr></thead>
                    <tbody>
                      {r.exhibit.rows.map(([c, b, w]) => (
                        <tr><th scope="row">{c}</th><td><strong>{b}</strong></td><td>{w}</td></tr>
                      ))}
                    </tbody>
                  </table>
                )}
                {r.exhibit.kind === 'costs' && r.exhibit.rows && (
                  <dl class="costs">
                    {r.exhibit.rows.map(([label, pct]) => (
                      <div class="costs__row">
                        <dt>{label}</dt>
                        <dd>
                          <span class="costs__bar" style={`--pct: ${pct}`} aria-hidden="true"></span>
                          <span class="costs__pct">{pct}%</span>
                        </dd>
                      </div>
                    ))}
                  </dl>
                )}
                {r.exhibit.kind === 'cutsheet' && (
                  <div class="cut cut--small" set:html={cutSheetSvg(durat.cutPlan.sheets[r.exhibit.sheet], r.exhibit.sheet + 1)} />
                )}
                {r.exhibit.kind === 'image' && exhibits[r.exhibit.id] && (
                  <picture>
                    <source type="image/webp" srcset={srcset(exhibits[r.exhibit.id])} sizes="(min-width: 48rem) 32rem, 92vw" />
                    <img
                      src={`${exhibits[r.exhibit.id].src}.jpg`}
                      width={exhibits[r.exhibit.id].width}
                      height={exhibits[r.exhibit.id].height}
                      alt={r.exhibit.alt}
                      loading="lazy"
                      decoding="async"
                    />
                  </picture>
                )}
              </div>
            )}
            {r.caption && <p class="role__caption">{r.caption}</p>}
          </li>
        ))}
      </ol>
    </section>

    <!-- ── Closing ──────────────────────────────────────────────────────────── -->
    <section class="container closing" aria-labelledby="closing-h">
      <h2 id="closing-h">{closing.heading}</h2>
      <p class="k-lead">{closing.text}</p>
      <p class="closing__cta">
        <a class="btn" href={closing.link.href}>{closing.link.label} →</a>
        <a class="btn btn--ghost" href={closing.more.href}>{closing.more.text}</a>
      </p>
    </section>
  </div>

  {/* Photo viewer. Progressive enhancement over plain links: without JS, every photo is a link
      to its largest file and that works fine on a phone. With JS, the same links open this
      <dialog> — Esc and focus-trapping come native with showModal(); ←/→ step through every
      photo on the page in order, including ones inside a closed "More photos". */}
  <dialog class="viewer" aria-label="Photo viewer">
    <figure class="viewer__fig">
      <img class="viewer__img" alt="" />
      <figcaption class="viewer__cap"><strong class="viewer__title"></strong> <span class="viewer__text"></span></figcaption>
    </figure>
    <div class="viewer__bar">
      <button type="button" class="viewer__btn" data-step="-1" aria-label="Previous photo">←</button>
      <span class="viewer__count" aria-live="polite"></span>
      <button type="button" class="viewer__btn" data-step="1" aria-label="Next photo">→</button>
      <button type="button" class="viewer__btn viewer__close" aria-label="Close">✕</button>
    </div>
  </dialog>
</BaseLayout>

<script>
  // Before/after wipe. The range input IS the control; this only mirrors its value into --pos.
  document.querySelectorAll<HTMLElement>('.ba').forEach((fig) => {
    const range = fig.querySelector<HTMLInputElement>('.ba__range');
    if (!range) return;
    range.hidden = false;
    fig.classList.add('ba--live');
    const set = () => fig.style.setProperty('--pos', `${range.value}%`);
    range.addEventListener('input', set);
    set();
  });

  const dialog = document.querySelector<HTMLDialogElement>('.viewer');
  const links = [...document.querySelectorAll<HTMLAnchorElement>('a[data-viewer]')];
  if (dialog && typeof dialog.showModal === 'function' && links.length) {
    const img = dialog.querySelector<HTMLImageElement>('.viewer__img')!;
    const title = dialog.querySelector('.viewer__title')!;
    const text = dialog.querySelector('.viewer__text')!;
    const count = dialog.querySelector('.viewer__count')!;
    let at = 0;
    let opener: HTMLElement | null = null;

    const show = (i: number) => {
      at = (i + links.length) % links.length;
      const a = links[at];
      const thumb = a.querySelector('img');
      img.src = a.href;
      img.alt = thumb?.alt ?? '';
      title.textContent = a.dataset.title ?? '';
      text.textContent = a.dataset.caption ?? '';
      count.textContent = `${at + 1} of ${links.length}`;
    };

    links.forEach((a, i) =>
      a.addEventListener('click', (e) => {
        if (e.metaKey || e.ctrlKey || e.shiftKey || e.button !== 0) return; // new-tab clicks still work
        e.preventDefault();
        opener = a;
        show(i);
        dialog.showModal();
      })
    );
    dialog.addEventListener('click', (e) => {
      const t = e.target as HTMLElement;
      if (t === dialog) return dialog.close(); // backdrop
      const step = t.closest<HTMLElement>('[data-step]')?.dataset.step;
      if (step) show(at + Number(step));
      if (t.closest('.viewer__close')) dialog.close();
    });
    dialog.addEventListener('keydown', (e) => {
      if (e.key === 'ArrowRight') { e.preventDefault(); show(at + 1); }
      if (e.key === 'ArrowLeft') { e.preventDefault(); show(at - 1); }
    });
    dialog.addEventListener('close', () => {
      img.removeAttribute('src');
      opener?.focus();
    });
  }
</script>

