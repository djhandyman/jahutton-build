---
import BaseLayout from '../layouts/BaseLayout.astro';
import ContactForm from '../components/ContactForm.astro';
import { socials, contact } from '../data/site.js';
---
<BaseLayout
  title="Contact — Jonathan A. Hutton"
  description="Get in touch with Jonathan A. Hutton about fractional, build-with-you, and zero-to-one engagements for solo operators, small businesses, and nonprofits."
>
  <section class="section">
    <div class="container contact">
      <div class="contact__main">
        <h1>Let's build something</h1>
        <p class="contact__lead">{contact.lead}</p>

        <h2 class="contact__prompts-heading">{contact.promptsHeading}</h2>
        <ul class="contact__prompts">
          {contact.prompts.map((p) => <li>{p}</li>)}
        </ul>
        <p class="contact__soft">{contact.promptsFooter}</p>
        {/* Sits after promptsFooter on purpose: the free door ("you just want to talk")
            is the one the reader meets first. This is a signpost, not a pitch. */}
        <p class="contact__soft contact__assessment">
          {contact.assessmentNudge.text}{' '}
          <a href={contact.assessmentNudge.href}>{contact.assessmentNudge.linkLabel}</a>{' '}
          {contact.assessmentNudge.tail}
        </p>

        <ContactForm />
      </div>

      <aside class="contact__aside">
        <h2>Elsewhere</h2>
        <ul class="contact__links">
          {socials.map((s) => (
            <li><a href={s.href} rel="noopener">{s.label}</a></li>
          ))}
        </ul>
        <p class="contact__availability">{contact.availability}</p>
      </aside>
    </div>
  </section>
</BaseLayout>

<style>
  .contact { display: grid; gap: var(--space-12); grid-template-columns: 1fr; }
  .contact__soft { color: var(--color-text-muted); }
  .contact__assessment { margin-top: calc(var(--space-3) * -1); }
  @media (min-width: 48rem) { .contact { grid-template-columns: 2fr 1fr; } }
  .contact__links { list-style: none; margin: 0; padding: 0; }
  .contact__links li { margin-bottom: var(--space-2); }

  .contact__lead { max-width: var(--measure); font-size: var(--text-lg); }

  /* The prompt list is a scannable "is this me?" check, not a section heading —
     so the heading sits small and quiet above it. */
  .contact__prompts-heading {
    font-family: inherit;
    font-size: var(--text-base);
    font-weight: 600;
    margin: var(--space-8) 0 var(--space-3);
  }
  .contact__prompts {
    max-width: var(--measure);
    list-style: none;
    margin: 0 0 var(--space-4);
    padding: 0;
  }
  .contact__prompts li {
    position: relative;
    padding-left: var(--space-6);
    margin-bottom: var(--space-3);
  }
  .contact__prompts li::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0.65em;
    width: var(--space-3);
    height: 1px;
    background: var(--color-accent);
  }

  .contact__availability {
    margin-top: var(--space-6);
    font-size: var(--text-sm);
    color: var(--color-text-muted);
  }
</style>
