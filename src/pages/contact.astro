---
import BaseLayout from '../layouts/BaseLayout.astro';
import ContactForm from '../components/ContactForm.astro';
import { socials } from '../data/site.js';
---
<BaseLayout title="Contact — Jonathan A. Hutton">
  <section class="section">
    <div class="container contact">
      <div class="contact__main">
        <h1>Let's build something</h1>
        <p>
          I take on a small number of engagements — fractional product and
          delivery work, build-with-you projects, and the occasional
          zero-to-one problem that needs an operator, not just an advisor.
          I work best with solo operators, small businesses, and nonprofits —
          people close enough to the work to decide fast and ship.
        </p>
        <p class="contact__soft">
          Not a formal project? Still worth a note. If you're building something
          and want to compare notes, I'd like to hear about it.
        </p>
        <ContactForm />
      </div>

      <aside class="contact__aside">
        <h2>Elsewhere</h2>
        <ul class="contact__links">
          {socials.map((s) => (
            <li><a href={s.href} rel="noopener">{s.label}</a></li>
          ))}
        </ul>
      </aside>
    </div>
  </section>
</BaseLayout>

<style>
  .contact { display: grid; gap: var(--space-12); grid-template-columns: 1fr; }
  .contact__soft { color: var(--color-text-muted); }
  @media (min-width: 48rem) { .contact { grid-template-columns: 2fr 1fr; } }
  .contact__links { list-style: none; margin: 0; padding: 0; }
  .contact__links li { margin-bottom: var(--space-2); }
</style>
