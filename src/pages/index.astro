---
import BaseLayout from '../layouts/BaseLayout.astro';
import { site } from '../data/site.js';
import { projects } from '../data/projects.js';

const featured = projects.slice(0, 4);
---
<BaseLayout description="Jonathan A. Hutton designs, builds, and ships — software, strategy, and structure for solo operators, small businesses, and nonprofits.">
  <section class="section hero">
    {/* Merge resolution (Jon, 2026-07-23): main's two-column hero__grid layout,
        carrying docs-refresh's paragliding image instead of the portrait.
        The portrait (/images/hero.*) is still in public/ but is now unused.
        JSX-style comment so it stays out of the shipped HTML. */}
    <div class="container hero__grid">
      <div class="hero__content">
        <p class="hero__kicker">Jonathan A. Hutton</p>
        <h1 class="hero__headline">{site.headline}</h1>
        <p class="hero__lead">{site.positioning}</p>
        <p class="cta-row">
          <a class="btn" href="/contact">Let’s build something</a>
          <a class="btn btn--ghost" href="/work">See the work →</a>
        </p>
      </div>
      <div class="hero__media">
        <img
          class="hero__img"
          src="/images/paragliding/coastal-flight.webp"
          width="1280"
          height="960"
          alt="Three paragliders soaring over the sea along a steep coastal bluff under a bright, cloud-scattered sky."
          fetchpriority="high"
        />
      </div>
    </div>
  </section>

  <section class="section section--alt">
    <div class="container">
      <h2>Selected work</h2>
      <ul class="grid">
        {featured.map((p) => (
          <li>
            <a class="mini" href={p.slug ? `/work/${p.slug}` : '/work'}>
              <span class="mini__cat">{p.category}</span>
              <span class="mini__title">{p.title}</span>
            </a>
          </li>
        ))}
      </ul>
      <p><a class="btn btn--ghost" href="/work">All projects →</a></p>
    </div>
  </section>
</BaseLayout>

<style>
  /* Hero — the calling card. Editorial display scale, generous air. */
  .hero { padding-block: var(--space-16); }
  .hero__grid { display: grid; gap: var(--space-12); align-items: center; }
  @media (min-width: 60rem) {
    .hero { padding-block: var(--space-24) var(--space-16); }
    .hero__grid { grid-template-columns: 1.05fr 0.95fr; gap: var(--space-16); }
  }
  /* Sized for the landscape paragliding shot (1280x960 = 4:3). The portrait-era
     rules that lived here — a 4/5 desktop crop and object-position 50% 22% to
     favor a face — would squeeze this image into a tall column, so both are gone.
     Restore them if the hero ever goes back to the portrait. */
  .hero__img {
    width: 100%;
    aspect-ratio: 4 / 3;
    object-fit: cover;
    border-radius: var(--radius-lg);
    border: 1px solid var(--color-border);
    box-shadow: var(--shadow);
  }
  .hero__kicker {
    font-family: var(--font-sans);
    text-transform: uppercase;
    letter-spacing: 0.14em;
    font-size: var(--text-sm);
    font-weight: 600;
    color: var(--color-accent);
    margin-bottom: var(--space-4);
  }
  .hero__headline {
    font-size: clamp(2.5rem, 6.5vw, 4.75rem);
    line-height: 1.02;
    font-weight: 600;
    letter-spacing: -0.02em;
    max-width: 15ch;
    margin-bottom: var(--space-6);
  }
  .hero__lead {
    font-size: var(--text-xl);
    line-height: 1.4;
    color: var(--color-text-muted);
    max-width: 38rem;
    margin-bottom: var(--space-8);
  }
  .cta-row { display: flex; flex-wrap: wrap; gap: var(--space-3); margin: 0; }

  /* Selected work — compact clickable tiles */
  .grid {
    list-style: none; margin: var(--space-8) 0 var(--space-8); padding: 0;
    display: grid; gap: var(--space-4);
    grid-template-columns: repeat(auto-fit, minmax(13rem, 1fr));
  }
  .mini {
    display: flex; flex-direction: column; gap: var(--space-2);
    padding: var(--space-6);
    background: var(--color-bg); border: 1px solid var(--color-border);
    border-radius: var(--radius); text-decoration: none; color: var(--color-text);
    transition: transform 0.15s ease, box-shadow 0.15s ease, border-color 0.15s ease;
  }
  .mini:hover {
    transform: translateY(-2px);
    box-shadow: var(--shadow);
    border-color: var(--color-accent);
    text-decoration: none;
  }
  .mini__cat { font-size: var(--text-sm); color: var(--color-text-muted); text-transform: uppercase; letter-spacing: 0.06em; }
  .mini__title { font-family: var(--font-heading); font-size: var(--text-lg); line-height: 1.2; }
</style>
