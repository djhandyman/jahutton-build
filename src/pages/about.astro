---
import BaseLayout from '../layouts/BaseLayout.astro';
import SubstackEmbed from '../components/SubstackEmbed.astro';
import TechStack from '../components/TechStack.astro';
import { about } from '../data/about.js';

// A paragraph is a plain string or an array of segments — see the shape notes in about.js.
// Normalised here so the template has one thing to map over instead of two.
const asSegments = (p) => (Array.isArray(p) ? p : [p]);
---
<BaseLayout
  title="About — Jonathan A. Hutton"
  description="Jonathan A. Hutton has spent 10+ years building durable things in digital and physical space — for small businesses, non-profits, and public sector teams."
>
  <section class="section">
    <div class="container prose">
      <h1>About</h1>

      <figure class="headshot">
        <picture>
          <source srcset="/images/headshot.webp" type="image/webp" />
          <img
            src="/images/headshot.jpg"
            width="640"
            height="640"
            alt="Jonathan A. Hutton"
            loading="lazy"
          />
        </picture>
      </figure>

      {about.intro.map((p) => (
        <p>
          {asSegments(p).map((seg) =>
            typeof seg === 'string' ? seg
              : seg.strong ? <strong>{seg.strong}</strong>
              : seg.em ? <em>{seg.em}</em>
              : <a href={seg.href} rel={seg.href.startsWith('/') ? undefined : 'noopener'}>{seg.text}</a>
          )}
        </p>
      ))}

      {/* The ask, while the intro's closing line is still on screen. `clear: both` because the
          headshot floats right above 48rem and the button would otherwise tuck under it. */}
      <div class="cta">
        <p class="cta__text">{about.cta.text}</p>
        <p><a class="btn" href={about.cta.href}>{about.cta.label}</a></p>
      </div>

      <h2>{about.stack.heading}</h2>
      {about.stack.intro.map((p) => (
        <p>
          {asSegments(p).map((seg) =>
            typeof seg === 'string' ? seg
              : seg.strong ? <strong>{seg.strong}</strong>
              : seg.em ? <em>{seg.em}</em>
              : <a href={seg.href} rel={seg.href.startsWith('/') ? undefined : 'noopener'}>{seg.text}</a>
          )}
        </p>
      ))}

      <TechStack />

      {about.sections.map((s) => (
        <>
          <h2>{s.heading}</h2>
          {s.body.map((p) => (
            <p>
              {asSegments(p).map((seg) =>
                typeof seg === 'string' ? seg
                  : seg.strong ? <strong>{seg.strong}</strong>
                  : seg.em ? <em>{seg.em}</em>
                  : <a href={seg.href} rel={seg.href.startsWith('/') ? undefined : 'noopener'}>{seg.text}</a>
              )}
            </p>
          ))}
        </>
      ))}
    </div>
  </section>

  <SubstackEmbed heading="Follow the work" />
</BaseLayout>

<style>
  .prose p { font-size: var(--text-lg); }
  .prose h2 { margin-top: var(--space-12); clear: both; }

  .cta { clear: both; margin-top: var(--space-8); }
  /* Deliberately NOT Fraunces (Jon, 2026-07-31). It's a sentence addressed to the reader, not a
     heading — setting it in the display face made it look like a section title that had lost its
     section. It inherits the body font and .prose's --text-lg like every other paragraph here;
     the button below it is what marks this as an ask. */
  .cta__text { margin-bottom: var(--space-4); }

  .headshot { margin: 0 0 var(--space-6); max-width: 260px; }
  .headshot img {
    border-radius: var(--radius-lg);
    border: 1px solid var(--color-border);
    box-shadow: var(--shadow);
  }
  @media (min-width: 48rem) {
    .headshot {
      float: right;
      width: 240px;
      margin: var(--space-1) 0 var(--space-6) var(--space-8);
    }
  }
</style>
