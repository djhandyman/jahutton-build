---
import BaseLayout from '../layouts/BaseLayout.astro';
import { services } from '../data/site.js';

// A paragraph is a plain string or an array of segments — same convention as /about and the
// project blurbs. Normalised so the template maps over one thing instead of two.
const asSegments = (p) => (Array.isArray(p) ? p : [p]);
---
<BaseLayout
  title="Services — Jonathan A. Hutton"
  description="How Jonathan A. Hutton works: a paid Build Assessment first, then zero-to-one, build-with-you, or fractional engagements. Fixed price per scoped outcome, never hourly."
>
  <section class="section">
    <div class="container services">
      <h1>{services.title}</h1>
      <p class="services__lead">{services.lead}</p>
      {/* `intro` is a segment array so the sentence can carry a link — same shape and the same
          renderer as /about and the project blurbs. Everything else on this page is a plain
          string and stays one; don't convert a field until it actually needs a link. */}
      <p class="services__intro">
        {asSegments(services.intro).map((seg) =>
          typeof seg === 'string' ? seg
            : seg.strong ? <strong>{seg.strong}</strong>
            : seg.em ? <em>{seg.em}</em>
            : <a href={seg.href} rel={seg.href.startsWith('/') ? undefined : 'noopener'}>{seg.text}</a>
        )}
      </p>

      {/* The assessment leads the page on purpose — it is the front door to all three
          shapes below, not a fourth option sitting beside them. */}
      <div class="services__start">
        <h2>{services.startHeading}</h2>
        <p>{services.start}</p>
        {/* The money gets its own paragraph — see the comment on `startPrice` in site.js. It is
            the sentence a reader has to be certain about, and it was buried. */}
        <p>{services.startPrice}</p>
        <p><a class="btn" href={services.startHref}>{services.startCtaLabel}</a></p>
      </div>

      <h2>{services.shapesHeading}</h2>
      <p>{services.shapesLead}</p>
      <ul class="services__shapes">
        {services.shapes.map((s) => (
          <li class="shape">
            <h3 class="shape__name">{s.name}</h3>
            <p class="shape__when">{s.when}</p>
            <p class="shape__body">{s.body}</p>
          </li>
        ))}
      </ul>

      <h2>{services.priceHeading}</h2>
      <p class="services__price">{services.price}</p>
      <p>{services.priceDetail}</p>

      <h2>{services.notHeading}</h2>
      <p>{services.notItems}</p>
      {/* The "Where to start" heading and its lead paragraph were removed 2026-08-02 (Jon),
          along with the `notTail` sign-off above — but the two buttons stayed. The page closes
          on the ask with no prose introducing it, which is the point: after "what I'm not the
          right person for", the reader gets two doors and no further pitch. */}
      <p class="cta-row">
        <a class="btn" href={services.ctaPrimaryHref}>{services.ctaPrimaryLabel}</a>
        <a class="btn btn--ghost" href={services.ctaSecondaryHref}>{services.ctaSecondaryLabel}</a>
      </p>
    </div>
  </section>
</BaseLayout>

<style>
  .services { max-width: var(--measure); }
  /* The party-line answer opens at display size — it's one short sentence and it should land
     before anything else on the page does. */
  .services__lead {
    font-family: var(--font-heading);
    font-size: var(--text-2xl);
    line-height: 1.25;
    margin-bottom: var(--space-6);
  }
  .services__intro { font-size: var(--text-lg); }
  .services h2 { margin-top: var(--space-12); }

  /* The assessment block is the one thing on this page that gets a container.
     Everything else is prose; this is the offer. */
  .services__start {
    margin-top: var(--space-12);
    padding: var(--space-8);
    background: var(--color-bg);
    border: 1px solid var(--color-border);
    border-left: 3px solid var(--color-accent);
    border-radius: var(--radius);
  }
  .services__start h2 { margin-top: 0; }
  .services__start p:last-child { margin-bottom: 0; }

  .services__shapes { list-style: none; margin: var(--space-6) 0 0; padding: 0; }
  .shape { margin-bottom: var(--space-8); }
  .shape__name {
    font-size: var(--text-lg);
    margin-bottom: var(--space-1);
  }
  /* The "when" line is the one a reader scans for — it is how they find themselves
     on this page. Accent it and let the body copy stay quiet underneath. */
  .shape__when {
    color: var(--color-accent);
    font-weight: 600;
    margin-bottom: var(--space-2);
  }
  .shape__body { margin-bottom: 0; }

  /* Jon's own sentence about pricing being as clear as his writing — it carries the section,
     so it gets the size and the rest of the paragraph sits under it at body weight. */
  .services__price { font-size: var(--text-lg); }
  /* `.services__cta` was dropped 2026-08-02 with the "Where to start" wrapper it styled; the
     button row it used to space now carries that margin itself. `.cta-row` is scoped to this
     component — index.astro has its own, untouched by anything here. */
  .cta-row {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
    margin: var(--space-12) 0 0;
  }
</style>
