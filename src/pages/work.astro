---
import BaseLayout from '../layouts/BaseLayout.astro';
import ProjectCard from '../components/ProjectCard.astro';
import { projects } from '../data/projects.js';
---
<BaseLayout
  title="Work — Jonathan A. Hutton"
  description="Selected work by Jonathan A. Hutton across software, systems, organizations, physical spaces, and writing — turning messes into finished things."
>
  <section class="section">
    <div class="container">
      <h1>Work</h1>
      <p class="lead">
        A through-line across software, systems, teams, spaces, organizations, and
        the written word.
      </p>

      <ul class="cards">
        {projects.map((p) => (
          <li>
            <ProjectCard
              title={p.title}
              category={p.category}
              role={p.role}
              status={p.status}
              teaser={p.teaser}
              blurb={p.blurb}
              slug={p.slug}
            />
          </li>
        ))}
      </ul>
    </div>
  </section>
</BaseLayout>

<style>
  .lead { font-size: var(--text-lg); max-width: var(--measure); }
  .cards {
    list-style: none; margin: var(--space-8) 0 0; padding: 0;
    display: grid; gap: var(--space-6);
    grid-template-columns: repeat(auto-fit, minmax(18rem, 1fr));
  }
  /* Card styling lives in ProjectCard.astro — every card on this page is that component. */
</style>
