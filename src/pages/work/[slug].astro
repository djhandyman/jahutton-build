---
import BaseLayout from '../../layouts/BaseLayout.astro';
import StackDiagram from '../../components/StackDiagram.astro';
import ProjectMetrics from '../../components/ProjectMetrics.astro';
import { projects } from '../../data/projects.js';

// Prerender one detail page per project that has a slug (the flagships).
export function getStaticPaths() {
  return projects
    .filter((p) => p.slug)
    .map((p) => ({ params: { slug: p.slug }, props: { project: p } }));
}

const { project } = Astro.props;
// `blurb` is a string for single-paragraph copy, or an array whose entries are paragraphs
// (strings), SEGMENT ARRAYS (a paragraph carrying an inline link or emphasis — same shape as
// about.js, added 2026-08-03), or list blocks ({ heading, items }).
const blocks = Array.isArray(project.blurb) ? project.blurb : [project.blurb];
// Flattens any block back to plain text. Used for the meta description, which must never
// contain markup and must not stringify an object into the page head.
const textOf = (b) =>
  typeof b === 'string'
    ? b
    : Array.isArray(b)
      ? b.map((s) => (typeof s === 'string' ? s : (s.text ?? s.strong ?? s.em ?? ''))).join('')
      : '';
// Per-page SEO: lead with the teaser, fall back to a trimmed first paragraph — skipping any
// list block, which would stringify to nothing useful.
const firstProse = blocks.map(textOf).find(Boolean) ?? '';
const description = project.teaser || `${firstProse.slice(0, 152)}…`;
// `link` is one CTA or several. The first is the primary pill; any others are ghosts —
// which is how a project keeps its outbound link while the ask goes first.
const ctas = project.link ? (Array.isArray(project.link) ? project.link : [project.link]) : [];
// Testimonial. The avatar falls back to an initials monogram until a real photo exists,
// so the block can go in before the headshot does.
const quote = project.testimonial;
const initials = quote
  ? quote.name
      .split(/\s+/)
      .map((w) => w.replace(/[^a-zA-Z]/g, '').charAt(0))
      .filter(Boolean)
      .slice(0, 2)
      .join('')
      .toUpperCase()
  : '';
---
<BaseLayout title={`${project.title} — Work — Jonathan A. Hutton`} description={description}>
  <section class="section">
    <div class="container prose project">
      <p class="project__back"><a href="/work">← Back to work</a></p>
      <p class="project__cat">{project.category}</p>
      <h1>{project.title}</h1>
      <p class="project__meta">
        {project.role}{project.status && <span class="project__status"> · {project.status}</span>}
      </p>

      {/* Optional scene-setter. Sits under the meta and above the body: the reader gets the
          title and the role first, then the world the project lives in, then the story. It is
          CONTEXT, not evidence — checkable material belongs in the exhibit zone below the CTA
          (metrics, gallery, diagram). Eager-loaded, unlike every other image on the page,
          because it's the one that's above the fold. */}
      {project.hero && (
        /* --ar caps the image by HEIGHT rather than width — see .hero below. A panoramic shot
           and a square one can't share a single max-width without one of them dominating. */
        <figure class="hero" style={`--ar: ${project.hero.width / project.hero.height}`}>
          <picture>
            <source srcset={`${project.hero.src}.webp`} type="image/webp" />
            <img
              src={`${project.hero.src}.jpg`}
              width={project.hero.width}
              height={project.hero.height}
              alt={project.hero.alt}
              fetchpriority="high"
              decoding="async"
            />
          </picture>
          {project.hero.caption && (
            <figcaption class="hero__caption">{project.hero.caption}</figcaption>
          )}
        </figure>
      )}

      {/* The suite, up top: one card per major component, so a reader sees the SHAPE of what was
          built before reading why. Deliberately above the body — on this project the scope is the
          headline, and burying it under six sentences of prose made the page read as one app.
          Pattern borrowed from TechStack.astro (labelled card + pills), so the two exhibits on
          the site that enumerate parts look like the same idea. Inline rather than a component,
          like .hero/.mark/.quote — markup, not logic, and the README's count tracks components.
          Replaced the single info callout on 2026-08-02 (Jon); that slot was deleted rather than
          left unrendered, same call as FlowDiagram — recoverable from git history. */}
      {project.components && (
        <section class="parts">
          {project.components.heading && <h2 class="parts__heading">{project.components.heading}</h2>}
          <div class="parts__grid">
            {project.components.items.map((c) => (
              <article class="parts__card">
                <p class="parts__label">{c.name}</p>
                <ul class="parts__pills">
                  {c.items.map((i) => <li class="parts__pill">{i}</li>)}
                </ul>
                {c.link && (
                  <p class="parts__link">
                    <a
                      href={c.link.href}
                      rel={c.link.href.startsWith('/') ? undefined : 'noopener'}
                    >{c.link.label} →</a>
                  </p>
                )}
              </article>
            ))}
          </div>
        </section>
      )}

      {/* A block is a paragraph or a labelled list — see the shape notes in projects.js. */}
      {blocks.map((b) =>
        typeof b === 'string' ? (
          <p class="project__body">{b}</p>
        ) : Array.isArray(b) ? (
          /* A paragraph carrying inline markup — same segment shape as about.js, so the two
             surfaces that need a link mid-sentence behave identically. Blurbs are still plain
             text by default; this is the escape hatch, not the norm. */
          <p class="project__body">
            {b.map((seg) =>
              typeof seg === 'string' ? (
                seg
              ) : seg.strong ? (
                <strong>{seg.strong}</strong>
              ) : seg.em ? (
                <em>{seg.em}</em>
              ) : (
                <a href={seg.href} rel={seg.href.startsWith('/') ? undefined : 'noopener'}>
                  {seg.text}
                </a>
              )
            )}
          </p>
        ) : (
          <div class="project__list">
            <p class="project__list-head">{b.heading}</p>
            <ul>{b.items.map((item) => <li>{item}</li>)}</ul>
          </div>
        )
      )}

      {/* The brand mark sits with the body, not in the exhibit zone below the CTA: where a
          project carries a logo, designing it was part of the job being described. */}
      {project.logo && (
        <figure class="mark">
          <picture>
            <source srcset={`${project.logo.src}.webp`} type="image/webp" />
            <img
              src={`${project.logo.src}.jpg`}
              width={project.logo.width}
              height={project.logo.height}
              alt={project.logo.alt}
              loading="lazy"
              decoding="async"
            />
          </picture>
          {project.logo.note && <figcaption class="mark__note">{project.logo.note}</figcaption>}
        </figure>
      )}

      {/* Proof sits between the story and the ask, so the CTA follows the evidence — the
          outcome numbers and the quote are both part of that zone. */}
      {project.metrics && <ProjectMetrics metrics={project.metrics} />}

      {quote && (
        <figure class="quote">
          <blockquote class="quote__text"><p>“{quote.quote}”</p></blockquote>
          <figcaption class="quote__who">
            {quote.photo ? (
              <picture>
                <source srcset={`${quote.photo.src}.webp`} type="image/webp" />
                <img
                  class="quote__avatar"
                  src={`${quote.photo.src}.jpg`}
                  width={quote.photo.width}
                  height={quote.photo.height}
                  alt={quote.photo.alt}
                  loading="lazy"
                  decoding="async"
                />
              </picture>
            ) : (
              <span class="quote__avatar quote__avatar--empty" aria-hidden="true">{initials}</span>
            )}
            <span class="quote__who-text">
              <span class="quote__name">{quote.name}</span>
              {(quote.role || quote.org) && (
                <span class="quote__role">{[quote.role, quote.org].filter(Boolean).join(', ')}</span>
              )}
            </span>
          </figcaption>
          {/* Renders only while `placeholder: true`. Deleting that one flag is what makes a
              testimonial live — nothing invented can reach the page looking real. */}
          {quote.placeholder && (
            <p class="quote__flag">Placeholder — not a real quote</p>
          )}
        </figure>
      )}

      {ctas.length > 0 && (
        <p class="project__cta">
          {/* `rel` only where it means something — a CTA is internal when it points at
              /contact/ and external when it points at the live thing. */}
          {ctas.map((cta, i) => (
            <a
              class={i === 0 ? 'btn' : 'btn btn--ghost'}
              href={cta.href}
              rel={cta.href.startsWith('/') ? undefined : 'noopener'}
            >{cta.label} →</a>
          ))}
        </p>
      )}

      {/* Opt-in per project: `diagram: true` renders the stack exhibit. Only the site's own
          case study uses it — it's specific to this stack, not a reusable "architecture"
          slot for other projects. Data lives in src/data/colophon.js. */}
      {project.diagram && (
        <>
          {/* Frames everything below the CTA as an appendix (Jon, 2026-07-30). Without it the
              diagram was the page's biggest visual object and therefore read as the headline,
              which put "serverless functions" in front of a reader who came for the work. */}
          <h2 class="hood">Under the hood</h2>
          <StackDiagram />
        </>
      )}

      {/* Exhibits. A group is an ordered run of shots under an optional heading — two for a
          before/after, three where the design sits between them. A group with no shots carries
          a `note` instead, which is how a section that's real work with nothing to show yet
          says so out loud rather than silently missing from the page. */}
      {project.gallery?.map((group) => (
        <figure class="ba">
          {group.heading && <h2 class="ba__heading">{group.heading}</h2>}
          {group.shots && (
            <div class="ba__pair" style={`--shots: ${group.shots.length}`}>
              {group.shots.map(({ label, img }) => (
                /* --ar drives the justified row at the widest breakpoint — see .ba__side below. */
                <div class="ba__side" style={`--ar: ${img.width / img.height}`}>
                  <p class="ba__label">{label}</p>
                  <picture>
                    <source srcset={`${img.src}.webp`} type="image/webp" />
                    <img
                      src={`${img.src}.jpg`}
                      width={img.width}
                      height={img.height}
                      alt={img.alt}
                      loading="lazy"
                      decoding="async"
                    />
                  </picture>
                </div>
              ))}
            </div>
          )}
          {group.note && <p class="ba__note">{group.note}</p>}
          {group.caption && <figcaption class="ba__caption">{group.caption}</figcaption>}
        </figure>
      ))}

      {/* TODO(jon): a tech-stack list slots in here as content lands. */}

      {/* Last thing on the page: the repo, for the reader who wants to check the claims.
          Octicon `mark-github` (Primer, MIT), inlined rather than made a component — it's
          used exactly once, and shipping an <img> for 16px of icon would be silly. */}
      {project.source && (
        <p class="project__source">
          <a href={project.source.href} rel="noopener">
            <svg viewBox="0 0 16 16" width="16" height="16" aria-hidden="true" focusable="false">
              <path
                fill="currentColor"
                d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27s1.36.09 2 .27c1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.012 8.012 0 0 0 16 8c0-4.42-3.58-8-8-8Z"
              />
            </svg>
            <span>{project.source.label}</span>
          </a>
        </p>
      )}
    </div>
  </section>
</BaseLayout>

<style>
  .project__back { font-size: var(--text-sm); margin-bottom: var(--space-6); }
  .project__cat {
    text-transform: uppercase; letter-spacing: 0.06em;
    font-size: var(--text-sm); color: var(--color-text-muted); margin-bottom: var(--space-2);
  }
  .project__meta { color: var(--color-text-muted); font-weight: 600; margin-bottom: var(--space-8); }
  .project__status { font-weight: 400; }
  /* Scene-setter. Wider than --measure so it reads as an establishing shot, but capped short
     of the container so it stays an inset image rather than a full-bleed banner — this is an
     editorial site, and a banner would make every detail page look like a landing page. Shares
     the 56rem cap with .hood/.stack so the page has one wide column, not three.
     The second cap is the load-bearing one: NO HERO IS TALLER THAN 30rem. Width alone can't
     govern this slot, because aspect ratios differ wildly — a 1.95:1 panoramic at 56rem is a
     comfortable band, but a 1:1 square at 56rem is 896px of photo before the reader reaches a
     word of copy. Capping height and deriving width from --ar means a wide shot fills the
     column and a square one sits at 30rem, and both stop at the same distance down the page. */
  .hero {
    margin: 0 0 var(--space-16);
    max-width: min(56rem, calc(30rem * var(--ar, 1.8)));
  }
  .hero img {
    display: block;
    width: 100%;
    height: auto;
    border-radius: var(--radius);
    border: 1px solid var(--color-border);
    background: var(--color-surface); /* fills the box while the image decodes */
  }
  .hero__caption {
    margin-top: var(--space-4);
    font-size: var(--text-sm);
    color: var(--color-text-muted);
  }

  /* The component suite. Matched to .hero's 56rem rather than TechStack's 52rem so the top of
     the page has ONE column edge — these sit directly under the image and a 4rem step would
     read as a mistake. */
  .parts { margin: 0 0 var(--space-16); max-width: 56rem; }
  .parts__heading {
    font-size: var(--text-xl);
    line-height: 1.2;
    margin: 0 0 var(--space-4);
    padding-bottom: var(--space-3);
    border-bottom: 1px solid var(--color-border);
  }
  /* auto-fit, like ProjectMetrics: three cards is today's count, not a constraint. A fourth
     component wraps instead of squeezing, and on a phone they stack. */
  .parts__grid {
    display: grid;
    gap: var(--space-4);
    grid-template-columns: repeat(auto-fit, minmax(14rem, 1fr));
  }
  .parts__card {
    display: flex;
    flex-direction: column;
    padding: var(--space-4);
    border: 1px solid var(--color-border);
    border-radius: var(--radius);
    background: var(--color-bg);
  }
  /* Rust, unlike TechStack's muted group labels: there the label named a shelf of other people's
     tools, here it names a thing Jon built. */
  .parts__label {
    margin: 0 0 var(--space-3);
    max-width: none;
    font-size: var(--text-sm);
    text-transform: uppercase;
    letter-spacing: 0.06em;
    font-weight: 600;
    color: var(--color-accent);
  }
  .parts__pills {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .parts__pill {
    padding: var(--space-1) var(--space-3);
    border: 1px solid var(--color-border);
    border-radius: 999px;
    background: var(--color-surface);
    font-family: var(--font-heading);
    font-size: var(--text-base);
    line-height: 1.4;
  }
  /* margin-top:auto pins the link to the card's foot, so a 2-pill card and a 4-pill card still
     line their links up across the row. */
  .parts__link {
    margin: var(--space-4) 0 0;
    padding-top: var(--space-1);
    font-size: var(--text-sm);
    font-weight: 600;
  }
  .parts__card .parts__pills { margin-bottom: auto; }

  .project__body { font-size: var(--text-lg); max-width: var(--measure); }
  .project__body + .project__body { margin-top: var(--space-6); }

  /* Labelled inventory. Held to the body measure so it reads as part of the column rather
     than a sidebar, and the heading is small — it labels a list, it doesn't open a section. */
  .project__list { margin-top: var(--space-8); max-width: var(--measure); }
  .project__list-head {
    font-family: var(--font-heading);
    font-size: var(--text-lg);
    margin: 0 0 var(--space-3);
  }
  .project__list ul { margin: 0; padding-left: 1.25em; }
  .project__list li { font-size: var(--text-lg); }
  .project__list li + li { margin-top: var(--space-2); }
  /* The paragraph after a list needs the gap the +.project__body rule above can't give it. */
  .project__list + .project__body { margin-top: var(--space-8); }

  /* Brand mark. Small, and on a white ground: the marks carry transparent backgrounds and the
     .jpg fallback is flattened onto white, so the card reads the same either way. */
  /* --space-12 matches .quote and .ba, the other objects that break the body column. This read
     `--space-10` until 2026-08-02 — a token that has never existed on the scale (1/2/3/4/6/8/
     12/16/24), so the declaration was invalid and the mark had NO top margin at all. */
  .mark { margin: var(--space-12) 0 0; max-width: var(--measure); }
  .mark img {
    display: block;
    width: 100%;
    max-width: 260px;
    height: auto;
    padding: var(--space-4);
    background: #fff;
    border: 1px solid var(--color-border);
    border-radius: var(--radius);
  }
  .mark__note {
    margin-top: var(--space-4);
    font-size: var(--text-sm);
    color: var(--color-text-muted);
  }
  /* Testimonial. Same measure as the body so it reads as part of the column, with a rust
     edge and the surface tint to lift it off the page. */
  .quote {
    margin: var(--space-12) 0 0;
    max-width: var(--measure);
    padding: var(--space-6);
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-left: 3px solid var(--color-accent);
    border-radius: var(--radius);
  }
  .quote__text { margin: 0; }
  .quote__text p {
    margin: 0;
    font-family: var(--font-heading);
    font-size: var(--text-lg);
    line-height: 1.5;
  }
  .quote__who {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    margin-top: var(--space-6);
  }
  .quote__avatar {
    width: 56px;
    height: 56px;
    flex: none;
    border-radius: 50%;
    object-fit: cover; /* a non-square headshot crops to the circle instead of squashing */
    background: var(--color-bg);
  }
  /* Stand-in until a real headshot lands — dashed, so it reads as "photo pending". */
  .quote__avatar--empty {
    display: grid;
    place-items: center;
    border: 1px dashed var(--color-border);
    color: var(--color-text-muted);
    font-family: var(--font-heading);
    font-size: var(--text-xl);
  }
  .quote__who-text { display: flex; flex-direction: column; }
  .quote__name { font-weight: 600; }
  .quote__role { font-size: var(--text-sm); color: var(--color-text-muted); }
  .quote__flag {
    margin: var(--space-4) 0 0;
    font-size: var(--text-sm);
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--color-text-muted);
  }

  /* Wraps to a stack on narrow screens rather than letting two pills collide. */
  .project__cta {
    margin-top: var(--space-8);
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
  }

  /* Source link — set off by a rule so it reads as a footer to the page, not another CTA. */
  .project__source {
    margin: var(--space-12) 0 0;
    padding-top: var(--space-6);
    border-top: 1px solid var(--color-border);
  }
  .project__source a {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    color: var(--color-text-muted);
    font-size: var(--text-sm);
    text-decoration: none;
  }
  .project__source a:hover { color: var(--color-accent); }
  .project__source a:hover span { text-decoration: underline; }
  .project__source svg { flex: none; }

  /* Section marker for the appendix zone. Matches .ba__heading so an exhibit run reads the same
     whether it opens with this or with a gallery group's own heading. The rule under it does the
     work — it's the line that says "the pitch is over, this is the detail". */
  .hood {
    max-width: 56rem; /* the diagram's width, not the body measure, so the rule spans it */
    font-size: var(--text-xl);
    line-height: 1.2;
    margin: var(--space-16) 0 0;
    padding-bottom: var(--space-3);
    border-bottom: 1px solid var(--color-border);
  }
  /* The diagram supplies its own --space-12 top margin, which would compound with the heading's
     bottom rule into a gap that reads as a break rather than a caption. */
  .hood + :global(.stack) { margin-top: var(--space-6); }

  /* Photo exhibits. Wider than --measure (the body text) but still short of the full
     container, so a group reads as an inset exhibit rather than a banner. */
  .ba { margin: var(--space-12) 0 0; max-width: 52rem; }
  /* Only appears where one page covers distinct subjects — the remodel's two rooms. */
  .ba__heading {
    font-size: var(--text-xl);
    line-height: 1.2;
    margin: 0 0 var(--space-4);
    padding-bottom: var(--space-3);
    border-bottom: 1px solid var(--color-border);
  }
  .ba__pair {
    display: grid;
    gap: var(--space-4);
    align-items: start; /* stacked/2-up: natural aspect ratios, tops line up */
  }
  /* Stacked on a phone. Two across on a tablet — a three-shot group wraps to 2 + 1 there,
     which still reads in sequence and beats three ~12rem columns. The full shot count only
     kicks in once there's room for it to be worth looking at. */
  @media (min-width: 40rem) {
    .ba__pair { grid-template-columns: repeat(2, minmax(0, 1fr)); gap: var(--space-6); }
  }
  /* Justified row (2026-07-30). Equal-width columns gave every group a ragged bottom edge —
     shots don't share an aspect ratio, so at equal widths they render at different heights and
     the caption gets stranded below the TALLEST one, floating in space under the shorter ones.
     Fix: give each shot a flex-grow equal to its aspect ratio, with flex-basis 0. Widths then
     come out proportional to aspect ratio, so every image resolves to the same height
     (width ÷ ar is constant) and the bottoms line up exactly. The caption sits snug under all
     of them. Nothing is cropped — the widths flex, not the pictures.
     Only at the widest breakpoint, where all shots share one row; below this the grid above
     still wraps 3 shots to 2 + 1, which flex-nowrap would squeeze. */
  @media (min-width: 52rem) {
    .ba__pair { display: flex; }
    .ba__side { flex: var(--ar, 1) 1 0; min-width: 0; }
  }
  /* A section with nothing to show yet. Dashed and muted on purpose — the same visual
     language as the testimonial's empty avatar, so "pending" is legible at a glance. */
  .ba__note {
    margin: 0;
    padding: var(--space-6);
    border: 1px dashed var(--color-border);
    border-radius: var(--radius);
    color: var(--color-text-muted);
    font-size: var(--text-sm);
  }
  .ba__label {
    text-transform: uppercase; letter-spacing: 0.06em;
    font-size: var(--text-sm); color: var(--color-text-muted);
    margin: 0 0 var(--space-3);
  }
  .ba__side img {
    width: 100%;
    border-radius: var(--radius);
    border: 1px solid var(--color-border);
    background: var(--color-surface); /* fills the box while the image decodes */
  }
  .ba__caption {
    margin-top: var(--space-4);
    font-size: var(--text-sm);
    color: var(--color-text-muted);
  }
</style>
