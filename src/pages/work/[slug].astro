---
import BaseLayout from '../../layouts/BaseLayout.astro';
import FlowDiagram from '../../components/FlowDiagram.astro';
import { projects } from '../../data/projects.js';

// Prerender one detail page per project that has a slug (the flagships).
export function getStaticPaths() {
  return projects
    .filter((p) => p.slug)
    .map((p) => ({ params: { slug: p.slug }, props: { project: p } }));
}

const { project } = Astro.props;
// `blurb` is a string for single-paragraph copy, or an array whose entries are either
// paragraphs (strings) or list blocks ({ heading, items }).
const blocks = Array.isArray(project.blurb) ? project.blurb : [project.blurb];
// Per-page SEO: lead with the teaser, fall back to a trimmed first paragraph — skipping any
// list block, which would stringify to nothing useful.
const firstProse = blocks.find((b) => typeof b === 'string') ?? '';
const description = project.teaser || `${firstProse.slice(0, 152)}…`;
// `link` is one CTA or several. The first is the primary pill; any others are ghosts —
// which is how a project keeps its outbound link while the ask goes first.
const ctas = project.link ? (Array.isArray(project.link) ? project.link : [project.link]) : [];
// Testimonial. The avatar falls back to an initials monogram until a real photo exists,
// so the block can go in before the headshot does.
const quote = project.testimonial;
const initials = quote
  ? quote.name
      .split(/\s+/)
      .map((w) => w.replace(/[^a-zA-Z]/g, '').charAt(0))
      .filter(Boolean)
      .slice(0, 2)
      .join('')
      .toUpperCase()
  : '';
---
<BaseLayout title={`${project.title} — Work — Jonathan A. Hutton`} description={description}>
  <section class="section">
    <div class="container prose project">
      <p class="project__back"><a href="/work">← Back to work</a></p>
      <p class="project__cat">{project.category}</p>
      <h1>{project.title}</h1>
      <p class="project__meta">
        {project.role}{project.status && <span class="project__status"> · {project.status}</span>}
      </p>

      {/* A block is a paragraph or a labelled list — see the shape notes in projects.js. */}
      {blocks.map((b) =>
        typeof b === 'string' ? (
          <p class="project__body">{b}</p>
        ) : (
          <div class="project__list">
            <p class="project__list-head">{b.heading}</p>
            <ul>{b.items.map((item) => <li>{item}</li>)}</ul>
          </div>
        )
      )}

      {/* The brand mark sits with the body, not in the exhibit zone below the CTA: where a
          project carries a logo, designing it was part of the job being described. */}
      {project.logo && (
        <figure class="mark">
          <picture>
            <source srcset={`${project.logo.src}.webp`} type="image/webp" />
            <img
              src={`${project.logo.src}.jpg`}
              width={project.logo.width}
              height={project.logo.height}
              alt={project.logo.alt}
              loading="lazy"
              decoding="async"
            />
          </picture>
          {project.logo.note && <figcaption class="mark__note">{project.logo.note}</figcaption>}
        </figure>
      )}

      {/* Proof sits between the story and the ask, so the CTA follows the evidence. */}
      {quote && (
        <figure class="quote">
          <blockquote class="quote__text"><p>“{quote.quote}”</p></blockquote>
          <figcaption class="quote__who">
            {quote.photo ? (
              <picture>
                <source srcset={`${quote.photo.src}.webp`} type="image/webp" />
                <img
                  class="quote__avatar"
                  src={`${quote.photo.src}.jpg`}
                  width={quote.photo.width}
                  height={quote.photo.height}
                  alt={quote.photo.alt}
                  loading="lazy"
                  decoding="async"
                />
              </picture>
            ) : (
              <span class="quote__avatar quote__avatar--empty" aria-hidden="true">{initials}</span>
            )}
            <span class="quote__who-text">
              <span class="quote__name">{quote.name}</span>
              {(quote.role || quote.org) && (
                <span class="quote__role">{[quote.role, quote.org].filter(Boolean).join(', ')}</span>
              )}
            </span>
          </figcaption>
          {/* Renders only while `placeholder: true`. Deleting that one flag is what makes a
              testimonial live — nothing invented can reach the page looking real. */}
          {quote.placeholder && (
            <p class="quote__flag">Placeholder — not a real quote</p>
          )}
        </figure>
      )}

      {ctas.length > 0 && (
        <p class="project__cta">
          {/* `rel` only where it means something — a CTA is internal when it points at
              /contact/ and external when it points at the live thing. */}
          {ctas.map((cta, i) => (
            <a
              class={i === 0 ? 'btn' : 'btn btn--ghost'}
              href={cta.href}
              rel={cta.href.startsWith('/') ? undefined : 'noopener'}
            >{cta.label} →</a>
          ))}
        </p>
      )}

      {/* Opt-in per project: `diagram: true` renders the request-flow exhibit. Only the
          site's own case study uses it — it's specific to this stack, not a reusable
          "architecture" slot. Data lives in src/data/colophon.js. */}
      {project.diagram && <FlowDiagram />}

      {/* Exhibits. A group is an ordered run of shots under an optional heading — two for a
          before/after, three where the design sits between them. A group with no shots carries
          a `note` instead, which is how a section that's real work with nothing to show yet
          says so out loud rather than silently missing from the page. */}
      {project.gallery?.map((group) => (
        <figure class="ba">
          {group.heading && <h2 class="ba__heading">{group.heading}</h2>}
          {group.shots && (
            <div class="ba__pair" style={`--shots: ${group.shots.length}`}>
              {group.shots.map(({ label, img }) => (
                <div class="ba__side">
                  <p class="ba__label">{label}</p>
                  <picture>
                    <source srcset={`${img.src}.webp`} type="image/webp" />
                    <img
                      src={`${img.src}.jpg`}
                      width={img.width}
                      height={img.height}
                      alt={img.alt}
                      loading="lazy"
                      decoding="async"
                    />
                  </picture>
                </div>
              ))}
            </div>
          )}
          {group.note && <p class="ba__note">{group.note}</p>}
          {group.caption && <figcaption class="ba__caption">{group.caption}</figcaption>}
        </figure>
      ))}

      {/* TODO(jon): a tech-stack list slots in here as content lands. */}

      {/* Last thing on the page: the repo, for the reader who wants to check the claims.
          Octicon `mark-github` (Primer, MIT), inlined rather than made a component — it's
          used exactly once, and shipping an <img> for 16px of icon would be silly. */}
      {project.source && (
        <p class="project__source">
          <a href={project.source.href} rel="noopener">
            <svg viewBox="0 0 16 16" width="16" height="16" aria-hidden="true" focusable="false">
              <path
                fill="currentColor"
                d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27s1.36.09 2 .27c1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.012 8.012 0 0 0 16 8c0-4.42-3.58-8-8-8Z"
              />
            </svg>
            <span>{project.source.label}</span>
          </a>
        </p>
      )}
    </div>
  </section>
</BaseLayout>

<style>
  .project__back { font-size: var(--text-sm); margin-bottom: var(--space-6); }
  .project__cat {
    text-transform: uppercase; letter-spacing: 0.06em;
    font-size: var(--text-sm); color: var(--color-text-muted); margin-bottom: var(--space-2);
  }
  .project__meta { color: var(--color-text-muted); font-weight: 600; margin-bottom: var(--space-8); }
  .project__status { font-weight: 400; }
  .project__body { font-size: var(--text-lg); max-width: var(--measure); }
  .project__body + .project__body { margin-top: var(--space-6); }

  /* Labelled inventory. Held to the body measure so it reads as part of the column rather
     than a sidebar, and the heading is small — it labels a list, it doesn't open a section. */
  .project__list { margin-top: var(--space-8); max-width: var(--measure); }
  .project__list-head {
    font-family: var(--font-heading);
    font-size: var(--text-lg);
    margin: 0 0 var(--space-3);
  }
  .project__list ul { margin: 0; padding-left: 1.25em; }
  .project__list li { font-size: var(--text-lg); }
  .project__list li + li { margin-top: var(--space-2); }
  /* The paragraph after a list needs the gap the +.project__body rule above can't give it. */
  .project__list + .project__body { margin-top: var(--space-8); }

  /* Brand mark. Small, and on a white ground: the marks carry transparent backgrounds and the
     .jpg fallback is flattened onto white, so the card reads the same either way. */
  .mark { margin: var(--space-10) 0 0; max-width: var(--measure); }
  .mark img {
    display: block;
    width: 100%;
    max-width: 260px;
    height: auto;
    padding: var(--space-4);
    background: #fff;
    border: 1px solid var(--color-border);
    border-radius: var(--radius);
  }
  .mark__note {
    margin-top: var(--space-4);
    font-size: var(--text-sm);
    color: var(--color-text-muted);
  }
  /* Testimonial. Same measure as the body so it reads as part of the column, with a rust
     edge and the surface tint to lift it off the page. */
  .quote {
    margin: var(--space-12) 0 0;
    max-width: var(--measure);
    padding: var(--space-6);
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-left: 3px solid var(--color-accent);
    border-radius: var(--radius);
  }
  .quote__text { margin: 0; }
  .quote__text p {
    margin: 0;
    font-family: var(--font-heading);
    font-size: var(--text-lg);
    line-height: 1.5;
  }
  .quote__who {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    margin-top: var(--space-6);
  }
  .quote__avatar {
    width: 56px;
    height: 56px;
    flex: none;
    border-radius: 50%;
    object-fit: cover; /* a non-square headshot crops to the circle instead of squashing */
    background: var(--color-bg);
  }
  /* Stand-in until a real headshot lands — dashed, so it reads as "photo pending". */
  .quote__avatar--empty {
    display: grid;
    place-items: center;
    border: 1px dashed var(--color-border);
    color: var(--color-text-muted);
    font-family: var(--font-heading);
    font-size: var(--text-xl);
  }
  .quote__who-text { display: flex; flex-direction: column; }
  .quote__name { font-weight: 600; }
  .quote__role { font-size: var(--text-sm); color: var(--color-text-muted); }
  .quote__flag {
    margin: var(--space-4) 0 0;
    font-size: var(--text-sm);
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--color-text-muted);
  }

  /* Wraps to a stack on narrow screens rather than letting two pills collide. */
  .project__cta {
    margin-top: var(--space-8);
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
  }

  /* Source link — set off by a rule so it reads as a footer to the page, not another CTA. */
  .project__source {
    margin: var(--space-12) 0 0;
    padding-top: var(--space-6);
    border-top: 1px solid var(--color-border);
  }
  .project__source a {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    color: var(--color-text-muted);
    font-size: var(--text-sm);
    text-decoration: none;
  }
  .project__source a:hover { color: var(--color-accent); }
  .project__source a:hover span { text-decoration: underline; }
  .project__source svg { flex: none; }

  /* Photo exhibits. Wider than --measure (the body text) but still short of the full
     container, so a group reads as an inset exhibit rather than a banner. */
  .ba { margin: var(--space-12) 0 0; max-width: 52rem; }
  /* Only appears where one page covers distinct subjects — the remodel's two rooms. */
  .ba__heading {
    font-size: var(--text-xl);
    line-height: 1.2;
    margin: 0 0 var(--space-4);
    padding-bottom: var(--space-3);
    border-bottom: 1px solid var(--color-border);
  }
  .ba__pair {
    display: grid;
    gap: var(--space-4);
    align-items: start; /* natural aspect ratios — tops line up, bottoms may not */
  }
  /* Stacked on a phone. Two across on a tablet — a three-shot group wraps to 2 + 1 there,
     which still reads in sequence and beats three ~12rem columns. The full shot count only
     kicks in once there's room for it to be worth looking at. */
  @media (min-width: 40rem) {
    .ba__pair { grid-template-columns: repeat(2, minmax(0, 1fr)); gap: var(--space-6); }
  }
  @media (min-width: 52rem) {
    .ba__pair { grid-template-columns: repeat(var(--shots, 2), minmax(0, 1fr)); }
  }
  /* A section with nothing to show yet. Dashed and muted on purpose — the same visual
     language as the testimonial's empty avatar, so "pending" is legible at a glance. */
  .ba__note {
    margin: 0;
    padding: var(--space-6);
    border: 1px dashed var(--color-border);
    border-radius: var(--radius);
    color: var(--color-text-muted);
    font-size: var(--text-sm);
  }
  .ba__label {
    text-transform: uppercase; letter-spacing: 0.06em;
    font-size: var(--text-sm); color: var(--color-text-muted);
    margin: 0 0 var(--space-3);
  }
  .ba__side img {
    width: 100%;
    border-radius: var(--radius);
    border: 1px solid var(--color-border);
    background: var(--color-surface); /* fills the box while the image decodes */
  }
  .ba__caption {
    margin-top: var(--space-4);
    font-size: var(--text-sm);
    color: var(--color-text-muted);
  }
</style>
