# Local secrets for `wrangler pages dev` — copy this file to `.dev.vars` (which is gitignored)
# and fill in the real value. These same vars must also be set in the Cloudflare Pages
# dashboard (Settings → Environment variables) for production.

RESEND_API_KEY=your_resend_api_key_here

# Optional overrides (the function has sensible defaults):
# CONTACT_TO=jahutton@gmail.com
# After verifying jahutton.build in Resend, switch the sender to your own domain:
# CONTACT_FROM="jahutton.build <forms@jahutton.build>"

# --- Feedback widget (functions/api/feedback.js) ---
# Claude API key — used server-side to tag feedback + occasionally generate a follow-up.
ANTHROPIC_API_KEY=your_anthropic_api_key_here
# Supabase project the feedback table lives in.
SUPABASE_URL=https://your-project-ref.supabase.co
# Service-role key — bypasses RLS, SERVER ONLY. Never expose this in the browser.
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here

# Optional feedback overrides (the function has sensible defaults):
# FEEDBACK_MODEL=claude-sonnet-4-6
# FEEDBACK_FOLLOWUP_RATE=0.3

# --- Build Assessment intake (functions/api/assessment-intake.js) ---
# Reuses the four secrets already above: RESEND_API_KEY (required — the email send),
# ANTHROPIC_API_KEY (optional — Claude triages each intake), and SUPABASE_URL +
# SUPABASE_SERVICE_ROLE_KEY (optional — saves each intake to the assessment_intake table).
# The email always sends; Supabase + triage are best-effort so a paused project never loses a lead.
# Optional override:
# INTAKE_MODEL=claude-sonnet-4-6
